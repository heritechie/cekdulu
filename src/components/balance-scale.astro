---
interface Props {
  class?: string;
  showLabels?: boolean;
}

const { class: className = 'w-full max-w-xs sm:max-w-sm lg:max-w-md', showLabels = false } = Astro.props;
---

<svg
  viewBox="0 0 360 260"
  width="100%"
  height="auto"
  preserveAspectRatio="xMidYMid meet"
  role="img"
  aria-label="Timbangan keuangan: penghasilan versus beban cicilan"
  class={className}
>
  <circle cx="180" cy="150" r="104" fill="var(--color-muted)" opacity="0.55" />
  <ellipse cx="180" cy="236" rx="64" ry="7" fill="currentColor" opacity="0.08" />

  <g fill="currentColor" stroke="none">
    <rect x="142" y="222" width="76" height="12" rx="6" />
    <rect x="171" y="74" width="18" height="148" rx="9" />
    <rect x="95" y="50" width="170" height="16" rx="8" />
    <circle cx="180" cy="42" r="11" />
    <path d="M172 66 L180 82 L188 66 Z" />
    <circle cx="104" cy="58" r="5" />
    <circle cx="256" cy="58" r="5" />
  </g>

  <g stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round" stroke-dasharray="2 6">
    <line x1="104" y1="66" x2="104" y2="138" />
    <line x1="256" y1="66" x2="256" y2="138" />
  </g>

  <g stroke="currentColor" stroke-width="6" stroke-linejoin="round" fill="var(--color-muted)">
    <path d="M86 138 Q104 160 122 138 Z" />
    <path d="M238 138 Q256 160 274 138 Z" />
  </g>

  <g style="opacity: var(--scale-income-opacity, 1)">
    <circle cx="104" cy="120" r="20" fill="var(--scale-income, #10b981)" fill-opacity="0.12" stroke="var(--scale-income, #10b981)" stroke-width="5" />
    <circle cx="104" cy="120" r="13" fill="none" stroke="var(--scale-income, #10b981)" stroke-width="3" opacity="0.7" />
    <text x="104" y="126" text-anchor="middle" font-size="16" font-weight="700" fill="var(--scale-income, #10b981)" font-family="inherit">Rp</text>
  </g>

  <g style="opacity: var(--scale-burden-opacity, 1)">
    <rect x="238" y="120" width="36" height="20" rx="3" fill="var(--scale-burden, #ef4444)" fill-opacity="0.12" stroke="var(--scale-burden, #ef4444)" stroke-width="5" />
    <path d="M236 122 L256 104 L276 122 Z" fill="var(--scale-burden, #ef4444)" fill-opacity="0.25" stroke="var(--scale-burden, #ef4444)" stroke-width="5" stroke-linejoin="round" />
    <rect x="252" y="130" width="8" height="10" rx="1" fill="var(--scale-burden, #ef4444)" />
  </g>

  {showLabels && (
    <g font-family="inherit" fill="var(--color-muted-foreground)">
      <text x="104" y="192" text-anchor="middle" font-size="13" font-weight="600">Penghasilan</text>
      <text x="256" y="188" text-anchor="middle" font-size="12.5" font-weight="600">Cicilan &amp;</text>
      <text x="256" y="203" text-anchor="middle" font-size="12.5" font-weight="600">Pengeluaran</text>
    </g>
  )}
</svg>
