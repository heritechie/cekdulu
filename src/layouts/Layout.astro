---
import '../styles/global.css';
import { Menu, ArrowRight } from 'lucide-astro';
import SiteLogo from '../components/site-logo.astro';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogUrl?: string;
  ogLocale?: string;
  ogSiteName?: string;
  ogImage?: string;
  twitterCard?: string;
  twitterTitle?: string;
  twitterDescription?: string;
}

const {
  title = 'CekDulu - Kalkulator Kemampuan Cicilan',
  description = 'Cek kemampuan finansial sebelum mengambil cicilan.',
  canonical = 'https://cekdulu.co.id/',
  ogTitle = title,
  ogDescription = description,
  ogType = 'website',
  ogUrl = canonical,
  ogLocale = 'id_ID',
  ogSiteName = 'CekDulu.co.id',
  ogImage = 'https://cekdulu.co.id/images/illustrations/hero-balance-v1.png',
  twitterCard = 'summary_large_image',
  twitterTitle = 'CekDulu',
  twitterDescription = description,
} = Astro.props;

const publicMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID as string | undefined;
const publicGoogleAdsId = import.meta.env.PUBLIC_GOOGLE_ADS_ID as string | undefined;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={ogSiteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Ilustrasi timbangan keuangan CekDulu" />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" content={twitterDescription} />
    <slot name="head" />
    {publicMeasurementId && (
      <script is:inline define:vars={{ publicMeasurementId, publicGoogleAdsId }}>
        (() => {
          const key = 'cekdulu_internal_analytics';
          const params = new URLSearchParams(window.location.search);

          try {
            if (params.get('internal') === '1') {
              window.localStorage.setItem(key, '1');
            } else if (params.get('internal') === '0') {
              window.localStorage.removeItem(key);
            }
          } catch {
            // Ignore storage errors and continue without internal filtering.
          }

          let isInternal = false;
          try {
            isInternal = window.localStorage.getItem(key) === '1';
          } catch {
            // Keep analytics enabled when storage is unavailable.
          }

          if (isInternal) return;

          window.dataLayer = window.dataLayer || [];
          function gtag() {
            window.dataLayer.push(arguments);
          }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', publicMeasurementId);

          if (publicGoogleAdsId) {
            gtag('config', publicGoogleAdsId);
          }

          // Defer only the gtag.js network request until the browser is idle so
          // analytics never competes with LCP/CLS for bandwidth. The config
          // command above is already queued in dataLayer, so the initial
          // page_view still fires once gtag.js loads. Tracking semantics unchanged.
          const loadGtag = () => {
            const script = document.createElement('script');
            script.async = true;
            script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(publicMeasurementId)}`;
            document.head.appendChild(script);
          };
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(loadGtag, { timeout: 2500 });
          } else {
            setTimeout(loadGtag, 2000);
          }
        })();
      </script>
    )}
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6620633467834759"
      crossorigin="anonymous"
    ></script>
  </head>
  <body class="font-sans antialiased min-h-screen bg-background text-foreground">
    <header class="relative border-b border-border/60">
      <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
        <SiteLogo />
        <div class="flex items-center gap-2">
          <nav aria-label="Menu utama" class="hidden items-center md:flex">
            <a
              href="/articles"
              class="rounded-full px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted"
            >
              Artikel
            </a>
            <a
              href="/challenges"
              class="rounded-full px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted"
            >
              Challenges
            </a>
            <a
              href="/tentang"
              class="rounded-full px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted"
            >
              Tentang
            </a>
          </nav>
          <a
            href="/kalkulator-kemampuan-cicilan"
            class={cn(
              buttonVariants({ variant: 'default' }),
              'ml-3 hidden gap-2 rounded-full px-6 py-2.5 text-sm font-semibold md:inline-flex',
            )}
          >
            Cek Kemampuan Cicilan
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
          <button
            id="menuBtn"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label="Menu"
            class="md:hidden inline-flex h-9 w-9 items-center justify-center rounded-full border border-border text-foreground transition-colors hover:bg-muted"
          >
            <Menu class="h-5 w-5" aria-hidden="true" />
          </button>
        </div>
      </div>
      <nav id="mobileMenu" aria-label="Menu utama" class="absolute left-0 right-0 top-full z-40 hidden w-full border-t border-b border-border/60 bg-background shadow-sm md:hidden">
        <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
          <a href="/" class="block py-4 text-base font-medium text-foreground">Beranda</a>
          <a href="/kalkulator-kemampuan-cicilan" class="block border-t border-border/60 py-4 text-base font-medium text-foreground">Cek Kemampuan Cicilan</a>
          <a href="/articles" class="block border-t border-border/60 py-4 text-base font-medium text-foreground">Artikel</a>
          <a href="/challenges" class="block border-t border-border/60 py-4 text-base font-medium text-foreground">Challenges</a>
          <a href="/tentang" class="block border-t border-border/60 py-4 text-base font-medium text-foreground">Tentang</a>
        </div>
      </nav>
    </header>

    <slot />

    <footer class="mt-16 border-t border-border/60">
      <div class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <a
              href="/"
              class="text-lg font-semibold leading-tight tracking-tight text-foreground transition-colors hover:text-foreground/80"
            >
              CekDulu
            </a>
            <p class="mt-1 text-sm text-muted-foreground">Baru Ambil Keputusan.</p>
          </div>
          <div class="text-sm text-muted-foreground sm:text-right">
            <nav aria-label="Tautan situs" class="flex flex-col gap-3 sm:items-end">
              <a href="/privacy-policy" class="transition-colors hover:text-foreground">Kebijakan Privasi</a>
              <a href="/for-marketers" class="transition-colors hover:text-foreground">CekDulu for Marketers →</a>
            </nav>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const menuBtn = document.getElementById('menuBtn');
      const mobileMenu = document.getElementById('mobileMenu');

      function setMenu(open: boolean) {
        mobileMenu?.classList.toggle('hidden', !open);
        menuBtn?.setAttribute('aria-expanded', String(open));
      }

      menuBtn?.addEventListener('click', () => {
        const isOpen = mobileMenu ? !mobileMenu.classList.contains('hidden') : false;
        setMenu(!isOpen);
      });

      mobileMenu?.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => setMenu(false));
      });

      document.addEventListener('click', (e) => {
        if (!e.target || !(e.target as Element).closest('#menuBtn, #mobileMenu')) {
          setMenu(false);
        }
      });
    </script>
  </body>
</html>
