---
import '../styles/global.css';
import { Menu } from 'lucide-astro';
import SiteLogo from '../components/site-logo.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogUrl?: string;
  ogLocale?: string;
  ogSiteName?: string;
  ogImage?: string;
  twitterCard?: string;
  twitterTitle?: string;
  twitterDescription?: string;
}

const {
  title = 'CekDulu - Kalkulator Kemampuan Cicilan',
  description = 'Cek kemampuan finansial sebelum mengambil cicilan.',
  canonical = 'https://cekdulu.my.id/',
  ogTitle = title,
  ogDescription = description,
  ogType = 'website',
  ogUrl = canonical,
  ogLocale = 'id_ID',
  ogSiteName = 'CekDulu.my.id',
  ogImage = 'https://cekdulu.my.id/images/illustrations/hero-balance-v1.png',
  twitterCard = 'summary_large_image',
  twitterTitle = 'CekDulu',
  twitterDescription = description,
} = Astro.props;

const publicMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID as string | undefined;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={ogSiteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Ilustrasi timbangan keuangan CekDulu" />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" content={twitterDescription} />
    <slot name="head" />
    {publicMeasurementId && (
      <script is:inline define:vars={{ publicMeasurementId }}>
        (() => {
          const key = 'cekdulu_internal_analytics';
          const params = new URLSearchParams(window.location.search);

          try {
            if (params.get('internal') === '1') {
              window.localStorage.setItem(key, '1');
            } else if (params.get('internal') === '0') {
              window.localStorage.removeItem(key);
            }
          } catch {
            // Ignore storage errors and continue without internal filtering.
          }

          let isInternal = false;
          try {
            isInternal = window.localStorage.getItem(key) === '1';
          } catch {
            // Keep analytics enabled when storage is unavailable.
          }

          if (isInternal) return;

          window.dataLayer = window.dataLayer || [];
          function gtag() {
            window.dataLayer.push(arguments);
          }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', publicMeasurementId);

          const script = document.createElement('script');
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(publicMeasurementId)}`;
          document.head.appendChild(script);
        })();
      </script>
    )}
  </head>
  <body class="font-sans antialiased min-h-screen bg-background text-foreground">
    <header class="relative border-b border-border/60">
      <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
        <SiteLogo />
        <button
          id="menuBtn"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label="Menu"
          class="md:hidden inline-flex h-9 w-9 items-center justify-center rounded-full border border-border text-foreground transition-colors hover:bg-muted"
        >
          <Menu class="h-5 w-5" aria-hidden="true" />
        </button>
      </div>
      <nav id="mobileMenu" aria-label="Menu utama" class="absolute left-0 right-0 top-full z-40 hidden w-full border-t border-b border-border/60 bg-background shadow-sm md:hidden">
        <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
          <a href="/" class="block py-4 text-base font-medium text-foreground">Beranda</a>
          <a href="/kalkulator-kemampuan-cicilan" class="block border-t border-border/60 py-4 text-base font-medium text-foreground">Kalkulator Cicilan</a>
          <a href="/challenges" class="block border-t border-border/60 py-4 text-base font-medium text-foreground">Challenges</a>
          <a href="/apa-itu-dbr" class="block border-t border-border/60 py-4 text-base font-medium text-foreground">DBR</a>
        </div>
      </nav>
    </header>

    <slot />

    <footer class="mt-16 border-t border-border/60">
      <div class="mx-auto w-full max-w-6xl px-4 py-8 text-sm text-muted-foreground sm:px-6 lg:px-8">
        <p>
          Sebelum nyicil, coba <a href="/" class="transition-colors hover:text-foreground underline underline-offset-4 decoration-muted-foreground/30">cekdulu.my.id</a>
        </p>
        <nav aria-label="Tautan situs" class="mt-4">
          <a href="/privacy-policy" class="transition-colors hover:text-foreground">Kebijakan Privasi</a>
        </nav>
      </div>
    </footer>

    <script>
      const menuBtn = document.getElementById('menuBtn');
      const mobileMenu = document.getElementById('mobileMenu');

      function setMenu(open: boolean) {
        mobileMenu?.classList.toggle('hidden', !open);
        menuBtn?.setAttribute('aria-expanded', String(open));
      }

      menuBtn?.addEventListener('click', () => {
        const isOpen = mobileMenu ? !mobileMenu.classList.contains('hidden') : false;
        setMenu(!isOpen);
      });

      mobileMenu?.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => setMenu(false));
      });

      document.addEventListener('click', (e) => {
        if (!e.target || !(e.target as Element).closest('#menuBtn, #mobileMenu')) {
          setMenu(false);
        }
      });
    </script>
  </body>
</html>
