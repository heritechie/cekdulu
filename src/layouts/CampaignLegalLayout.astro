---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  heading: string;
  updated: string;
}

const { title, description, canonical, heading, updated } = Astro.props;
const marketerAppUrl = import.meta.env.PUBLIC_MARKETER_APP_URL;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="CekDulu.co.id" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="flex min-h-screen flex-col bg-background font-sans text-foreground antialiased">
    <header class="border-b border-border/60">
      <div class="mx-auto flex w-full max-w-5xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6 lg:px-8">
        <a
          href="/for-marketers"
          class="inline-flex items-center"
        >
          <img
            src="/images/logo-cekdulu-for-marketers.png"
            alt="CekDulu for Marketers"
            width="2170"
            height="725"
            decoding="async"
            class="h-9 w-auto object-contain sm:h-11"
          />
        </a>
        {marketerAppUrl && (
          <a
            href={marketerAppUrl}
            class="inline-flex items-center gap-1.5 rounded-full bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/80"
          >
            Coba Buat Campaign Gratis
          </a>
        )}
      </div>
    </header>

    <main class="flex-1">
      <div class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
        <h1 class="text-balance text-3xl font-bold leading-tight tracking-tight sm:text-4xl">
          {heading}
        </h1>
        <p class="mt-3 text-sm text-muted-foreground">Terakhir diperbarui: {updated}</p>
        <div class="mt-8 h-px bg-border/60" aria-hidden="true"></div>
        <div class="space-y-10 pt-8">
          <slot />
        </div>
      </div>
    </main>

    <footer class="border-t border-border/60">
      <div class="mx-auto w-full max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <a
            href="/for-marketers"
            class="text-sm font-medium text-foreground transition-colors hover:text-foreground/80"
          >
            CekDulu for Marketers
          </a>
          <nav aria-label="Dokumen legal" class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
            <a
              href="/for-marketers/terms"
              class="text-primary underline underline-offset-4 decoration-primary/30 transition-colors hover:decoration-primary"
            >
              Syarat &amp; Ketentuan
            </a>
            <a
              href="/for-marketers/privacy"
              class="text-primary underline underline-offset-4 decoration-primary/30 transition-colors hover:decoration-primary"
            >
              Kebijakan Privasi
            </a>
          </nav>
          <p class="text-sm text-muted-foreground">&copy; 2026 CekDulu</p>
        </div>
      </div>
    </footer>
  </body>
</html>