---
import Layout from '../layouts/Layout.astro';
import { ArrowRight } from 'lucide-astro';
import { articles } from '../lib/articles';

const canonical = new URL('articles', Astro.site).href;
const itemListJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: articles.map((article, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Article',
      name: article.title,
      description: article.description,
      url: new URL(article.href, Astro.site).href,
      publisher: { '@type': 'Organization', name: 'CekDulu' },
    },
  })),
});
---

<Layout
  title="Artikel Finansial & Cicilan | CekDulu"
  description="Panduan sederhana memahami cicilan, pengeluaran, dan kemampuan finansial sebelum nyicil. Baca apa itu DBR dan cara menilai cicilan yang sehat."
  canonical={canonical}
  ogTitle="Artikel Finansial & Cicilan | CekDulu"
  ogDescription="Panduan sederhana memahami cicilan, pengeluaran, dan kemampuan finansial sebelum nyicil."
  ogType="website"
  ogUrl={canonical}
>
  <main>
    <section class="mx-auto w-full max-w-6xl px-4 pt-10 pb-12 sm:px-6 sm:pt-14 sm:pb-16 lg:px-8">
      <div class="mx-auto max-w-2xl">
        <header class="text-center">
          <p class="text-sm font-medium text-muted-foreground">Pelajari Sebelum Nyicil</p>
          <h1 class="mt-2 text-balance text-3xl font-bold tracking-tight sm:text-4xl">Artikel CekDulu</h1>
          <p class="mx-auto mt-3 max-w-xl text-base text-muted-foreground sm:text-lg">
            Panduan sederhana untuk memahami cicilan, pengeluaran, dan keputusan finansial sebelum nyicil.
          </p>
        </header>

        <div class="mt-8 grid gap-3 sm:grid-cols-2 sm:items-start">
          {
            articles.map((article) => (
              <article class="rounded-xl border border-border bg-card p-5 transition-colors hover:bg-muted/50">
                <a href={article.href} class="group block">
                  <p class="text-xs font-medium text-muted-foreground">{article.category}</p>
                  <h2 class="mt-1 text-base font-semibold text-foreground">{article.title}</h2>
                  <p class="mt-2 text-sm text-muted-foreground">{article.description}</p>
                  <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-primary">
                    Baca artikel
                    <ArrowRight
                      class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
                      aria-hidden="true"
                    />
                  </span>
                </a>
              </article>
            ))
          }
        </div>

        <div class="mt-8 rounded-xl border border-dashed border-border bg-muted/40 p-5 text-center">
          <p class="text-sm text-muted-foreground">Masih ragu dengan kemampuan cicilanmu?</p>
          <a
            href="/kalkulator-kemampuan-cicilan"
            class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold text-primary transition-colors hover:text-primary/80"
          >
            Cek kemampuan cicilanmu
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>
  </main>

  <script type="application/ld+json" is:inline set:html={itemListJsonLd}></script>
</Layout>