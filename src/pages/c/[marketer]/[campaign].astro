---
import '../../../styles/global.css';
import { cn } from '../../../lib/utils';
import { campaignMarketers } from '../../../data/campaigns';
import type { Campaign, CampaignMarketer, CampaignTemplateId } from '../../../data/campaigns';
import {
  ArrowLeft,
  ArrowRight,
  BadgeCheck,
  Bike,
  Bookmark,
  Bus,
  Car,
  Check,
  CircleAlert,
  CircleCheck,
  ChevronDown,
  ChevronLeft,
  ChevronRight,
  CreditCard,
  Ellipsis,
  File,
  GraduationCap,
  HeartPulse,
  Home,
  Lightbulb,
  MapPin,
  Maximize2,
  Minus,
  Plus,
  Scale,
  Shield,
  SlidersHorizontal,
  Tag,
  Utensils,
  X,
} from 'lucide-astro';

export function getStaticPaths() {
  return campaignMarketers.flatMap((marketer) =>
    marketer.campaigns
      .filter((campaign) => campaign.template === 'kpr')
      .map((campaign) => ({
        params: { marketer: marketer.slug, campaign: campaign.slug },
        props: { marketer, campaign },
      })),
  );
}

const { marketer, campaign } = Astro.props as { marketer: CampaignMarketer; campaign: Campaign };

const canonical = new URL(`c/${marketer.slug}/${campaign.slug}`, Astro.site).href;
const publicMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID as string | undefined;
const metaTitle = `${campaign.name} di ${campaign.developerName ?? marketer.name} - CekDulu`;
const metaDescription = campaign.seoDescription;
const ogImage = new URL('/images/illustrations/hero-balance-v1.png', Astro.site).href;

const campaignTypeByTemplate: Partial<Record<CampaignTemplateId, { campaignType: string; propertyType: string }>> = {
  kpr: { campaignType: 'property', propertyType: 'rumah' },
};
const campaignTypeInfo = campaignTypeByTemplate[campaign.template];
const campaignType = campaignTypeInfo?.campaignType ?? campaign.template;
const propertyType = campaignTypeInfo?.propertyType ?? campaign.template;

const campaignConfig = {
  price: campaign.params.price,
  priceLabel: campaign.priceLabel,
  annualInterestRate: campaign.params.annualInterestRate,
  promoInterest: campaign.params.promoInterest,
  promoPeriodYears: campaign.params.promoPeriodYears,
  floatingInterest: campaign.params.floatingInterest,
  syariahMargin: campaign.params.syariahMargin,
  tenorPresetsMonths: campaign.tenorPresetsMonths,
  defaultTenorMonths: campaign.defaultTenorMonths,
  whatsapp: campaign.whatsapp,
  whatsappMessage: campaign.whatsappMessage,
  marketerSlug: marketer.slug,
  marketerName: marketer.name,
  campaignSlug: campaign.slug,
  campaignName: campaign.name,
  developerName: campaign.developerName,
  template: campaign.template,
  campaignType,
  propertyType,
};
const campaignConfigJson = JSON.stringify(campaignConfig);

const propertyTitle = campaign.developerName
  ? `${campaign.developerName} - ${campaign.name}`
  : campaign.name;

const sheetPriceContext = `Rp${Math.round(campaign.params.price / 1_000_000)} jt`;

const specShort = (label: string) =>
  label === 'Tanah'
    ? 'tanah'
    : label === 'Bangunan'
      ? 'bangunan'
      : label === 'Kamar tidur'
        ? 'KT'
        : label === 'Kamar mandi'
          ? 'KM'
          : label;

const specs = campaign.specs.map((spec) => `${spec.value} ${specShort(spec.label)}`);

const gallery = campaign.images?.length ? campaign.images : [campaign.image];

const interestLabel = campaign.params.annualInterestRate.toLocaleString('id-ID', {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
});

const moneyWrapCls =
  'relative rounded-xl border border-input bg-background transition-colors focus-within:border-ring focus-within:ring-3 focus-within:ring-ring/50';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content="noindex" />
    <title>{metaTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="CekDulu.co.id" />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {publicMeasurementId && (
      <script is:inline define:vars={{ publicMeasurementId }}>
        (() => {
          const key = 'cekdulu_internal_analytics';
          const params = new URLSearchParams(window.location.search);

          try {
            if (params.get('internal') === '1') {
              window.localStorage.setItem(key, '1');
            } else if (params.get('internal') === '0') {
              window.localStorage.removeItem(key);
            }
          } catch {
            // Ignore storage errors and continue without internal filtering.
          }

          let isInternal = false;
          try {
            isInternal = window.localStorage.getItem(key) === '1';
          } catch {
            // Keep analytics enabled when storage is unavailable.
          }

          if (isInternal) return;

          window.dataLayer = window.dataLayer || [];
          function gtag() {
            window.dataLayer.push(arguments);
          }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', publicMeasurementId);

          const loadGtag = () => {
            const script = document.createElement('script');
            script.async = true;
            script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(publicMeasurementId)}`;
            document.head.appendChild(script);
          };
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(loadGtag, { timeout: 2500 });
          } else {
            setTimeout(loadGtag, 2000);
          }
        })();
      </script>
    )}
  </head>
  <body
    class="font-sans antialiased min-h-screen bg-background text-foreground"
    data-campaign-config={campaignConfigJson}
  >
    <main>
      <div id="catalog-view">
        <div class="campaign-container">
        <section aria-label="Katalog properti" class="relative">
          <div class="relative bg-muted/70 h-full" id="photo-gallery">
            <div
              id="photo-carousel"
              role="region"
              aria-roledescription="carousel"
              aria-label={`Foto ${campaign.name}`}
              class="flex w-full snap-x snap-mandatory touch-pan-x overflow-x-auto scrollbar-hide"
            >
              {gallery.map((src, index) => (
                <figure class="relative h-full w-full shrink-0 snap-start bg-muted/70">
                  <img
                    src={src}
                    alt={index === 0 ? campaign.imageAlt : `${campaign.name} — foto ${index + 1}`}
                    width="640"
                    height="1138"
                    decoding="async"
                    loading={index === 0 ? 'eager' : 'lazy'}
                    fetchpriority={index === 0 ? 'high' : 'auto'}
                    class="block w-full h-auto object-contain"
                  />
                </figure>
              ))}
            </div>

            {gallery.length > 1 && (
              <>
                <button
                  id="photo-prev"
                  type="button"
                  aria-label="Foto sebelumnya"
                  class="absolute left-3 top-1/2 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/40 text-white backdrop-blur transition-colors hover:bg-black/60 disabled:opacity-40 disabled:hover:bg-black/40 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50 sm:inline-flex"
                >
                  <ChevronLeft class="h-5 w-5" aria-hidden="true" />
                </button>
                <button
                  id="photo-next"
                  type="button"
                  aria-label="Foto berikutnya"
                  class="absolute right-3 top-1/2 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/40 text-white backdrop-blur transition-colors hover:bg-black/60 disabled:opacity-40 disabled:hover:bg-black/40 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50 sm:inline-flex"
                >
                  <ChevronRight class="h-5 w-5" aria-hidden="true" />
                </button>
              </>
            )}

            <button
              id="photo-expand"
              type="button"
              aria-label="Lihat foto penuh"
              class="absolute right-3 top-3 z-10 flex h-9 w-9 cursor-pointer items-center justify-center rounded-full bg-black/40 text-white backdrop-blur transition-colors hover:bg-black/60 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
            >
              <Maximize2 class="h-4 w-4" aria-hidden="true" />
            </button>

            {gallery.length > 1 && (
              <div
                id="photo-dots"
                class="absolute inset-x-0 top-2 z-10 flex items-center justify-center gap-1.5"
                aria-label="Indikator foto"
              >
                {gallery.map((_, index) => (
                  <button
                    type="button"
                    data-photo-dot={index}
                    aria-label={`Lihat foto ${index + 1}`}
                    class={`h-1.5 rounded-full transition-all ${index === 0 ? 'w-4 bg-primary' : 'w-1.5 bg-foreground/25'}`}
                  ></button>
                ))}
              </div>
            )}
          </div>

          <div
            id="campaign-info-overlay"
            class="rounded-2xl bg-black/75 p-3.5 shadow-lg sm:p-5 max-sm:p-3"
            aria-label="Informasi properti"
          >
            <p class="text-[13px] font-medium text-white/70 max-sm:text-[12px]">{marketer.name}</p>
            <h2 class="mt-0.5 text-[20px] font-bold leading-tight text-white sm:text-[22px] max-sm:text-[18px]">
              {propertyTitle}
            </h2>
            {campaign.location && (
              <p class="mt-1 flex items-center gap-1 text-[12px] text-white/60 max-sm:mt-0.5 max-sm:text-[11px]">
                <MapPin class="h-3.5 w-3.5 shrink-0 text-white/50" aria-hidden="true" />
                {campaign.location}
              </p>
            )}
            <div class="mt-1 text-xs text-white/65 max-sm:mt-0.5 max-sm:text-[11px]">
              {campaign.unitType && (
                <p class="flex items-center gap-1.5 font-medium text-white/85">
                  <Home class="h-3.5 w-3.5 shrink-0 text-white/60" aria-hidden="true" />
                  {campaign.unitType}
                </p>
              )}
              {specs.length > 0 && <p class="mt-0">{specs.join(' · ')}</p>}
            </div>
            <p class="mt-1 flex items-center gap-1.5 text-[17px] font-bold text-white max-sm:mt-0.5 max-sm:text-[16px]">
              <Tag class="h-4 w-4 shrink-0 text-white/60" aria-hidden="true" />
              Mulai <span class="whitespace-nowrap">{campaign.priceLabel.replace(/^Rp\./, 'Rp')}</span>
            </p>
            {campaign.highlights && campaign.highlights.length > 0 && (
              <div class="mt-1 border-t border-white/15 pt-1 max-sm:mt-0.5 max-sm:pt-0.5">
                <p class="text-[11px] font-semibold leading-snug text-white/70">
                  Kenapa pilih {propertyTitle || 'properti ini'}?
                </p>
                <ul class="mt-1 space-y-0.5 max-sm:mt-0.5 max-sm:space-y-0">
                  {campaign.highlights.slice(0, 2).map((item) => (
                    <li class="flex items-start gap-1.5 text-xs text-white/85 max-sm:text-[11px] max-sm:leading-snug">
                      <Check class="mt-0.5 h-3 w-3 shrink-0 text-white/80" aria-hidden="true" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            <button
              type="button"
              data-campaign-cta="kpr_check"
              data-start-wizard
              class="mt-2 inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-primary px-6 py-2.5 text-sm font-semibold text-primary-foreground transition-colors outline-none hover:bg-primary/90 focus-visible:ring-3 focus-visible:ring-ring/50 max-sm:mt-1.5 max-sm:py-1.5"
            >
              Cek Kemampuan Cicilan
              <ArrowRight class="h-5 w-5" aria-hidden="true" />
            </button>
          </div>
        </section>
        </div>
      </div>

      <div
        id="photo-viewer"
        role="dialog"
        aria-modal="true"
        aria-label="Lihat foto penuh"
        class="fixed inset-0 z-[60] hidden overflow-hidden bg-black"
      >
        <div class="relative h-full">
          <div
            id="photo-viewer-track"
            class="absolute inset-0 flex snap-x snap-mandatory touch-pan-x overflow-x-auto overscroll-x-contain scrollbar-hide"
          >
            {gallery.map((src, index) => (
              <div
                data-viewer-slide
                class="flex h-full w-full shrink-0 snap-start items-center justify-center bg-black"
              >
                <img
                  src={src}
                  alt={index === 0 ? campaign.imageAlt : `${campaign.name} — foto ${index + 1}`}
                  width="640"
                  height="1138"
                  loading="lazy"
                  decoding="async"
                  class="block h-full w-full object-contain object-top"
                />
              </div>
            ))}

            {gallery.length > 1 && (
              <>
                <button
                  id="photo-viewer-prev"
                  type="button"
                  aria-label="Foto sebelumnya"
                  class="absolute left-3 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-white/40 sm:inline-flex disabled:opacity-40"
                >
                  <ChevronLeft class="h-6 w-6" aria-hidden="true" />
                </button>
                <button
                  id="photo-viewer-next"
                  type="button"
                  aria-label="Foto berikutnya"
                  class="absolute right-3 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-white/40 sm:inline-flex disabled:opacity-40"
                >
                  <ChevronRight class="h-6 w-6" aria-hidden="true" />
                </button>
              </>
            )}
          </div>

          <p
            id="photo-viewer-counter"
            class="absolute left-4 top-[calc(env(safe-area-inset-top)+16px)] z-20 text-[13px] font-semibold text-white [text-shadow:0_1px_4px_rgba(0,0,0,0.6)]"
          >
            1 / {gallery.length}
          </p>

          <button
            id="photo-viewer-close"
            type="button"
            aria-label="Tutup foto"
            class="absolute right-3 top-[calc(env(safe-area-inset-top)+10px)] z-20 grid h-11 w-11 cursor-pointer place-items-center rounded-full bg-black/20 text-white transition-colors hover:bg-black/35 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/50 outline-none"
          >
            <X class="h-6 w-6" aria-hidden="true" />
          </button>

          <div
            class="pointer-events-none absolute inset-x-0 bottom-0 z-[1] h-28 bg-gradient-to-t from-black/30 to-transparent"
            aria-hidden="true"
          ></div>

          <button
            id="photo-viewer-cta"
            type="button"
            data-campaign-cta="kpr_check"
            data-start-wizard
            class="absolute inset-x-4 bottom-[calc(env(safe-area-inset-bottom)+16px)] z-20 inline-flex h-[53px] cursor-pointer items-center justify-center gap-2 rounded-full bg-primary px-6 text-base font-semibold text-primary-foreground shadow-lg transition-colors outline-none hover:bg-primary/90 focus-visible:ring-3 focus-visible:ring-ring/50"
          >
            Cek Kemampuan Cicilan
            <ArrowRight class="h-5 w-5" aria-hidden="true" />
          </button>
        </div>
      </div>

      <div
        id="sheet-backdrop"
        class="pointer-events-none fixed inset-0 z-40 bg-background/70 opacity-0 transition-opacity duration-300"
        aria-hidden="true"
      ></div>

      <div
        id="bottom-sheet"
        role="dialog"
        aria-modal="true"
        aria-labelledby="sheet-context-title"
        tabindex="-1"
        class="fixed inset-x-0 bottom-0 z-50 translate-y-full rounded-t-3xl border border-b-0 border-border bg-background shadow-[0_-12px_40px_rgba(0,0,0,0.15)] transition-transform duration-300 ease-out"
      >
        <div id="wizard-shell" class="flex h-full flex-col">
          <div id="sheet-handle" class="flex justify-center pt-2.5">
            <span class="h-1.5 w-12 cursor-grab rounded-full bg-muted-foreground/30" aria-hidden="true"></span>
          </div>
          <div class="flex items-center justify-between gap-3 border-b border-border/60 px-5 pb-3 pt-1.5 sm:px-6">
            <div class="min-w-0">
              <p id="sheet-context-title" class="truncate text-sm font-bold text-foreground">{propertyTitle}</p>
              <p class="truncate text-xs text-muted-foreground">
                {sheetPriceContext} · {campaign.unitType}
              </p>
            </div>
            <button
              id="sheet-close"
              type="button"
              aria-label="Tutup simulasi"
              class="grid h-9 w-9 shrink-0 cursor-pointer place-items-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50 outline-none"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path>
              </svg>
            </button>
          </div>

          <div id="wizard" class="scroll-mt-4 min-h-0 flex-1 overflow-y-auto overscroll-contain" data-sheet-scroll>
            <div class="px-5 pt-3 pb-1 flex items-center justify-between">
              <button
                id="wizard-back"
                type="button"
                data-back
                hidden
                class="-ml-2 inline-flex items-center gap-1.5 rounded-md px-2 py-1.5 text-xs font-semibold text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50"
              >
                <ArrowLeft class="h-3.5 w-3.5" aria-hidden="true" />
                Kembali
              </button>
              <p class="ml-auto flex items-center gap-1 text-[11px] text-muted-foreground">
                <Shield class="h-3 w-3 text-primary/70" aria-hidden="true" />
                Data tersimpan aman di perangkatmu
              </p>
            </div>

            <div class="px-5 pb-6 pt-4 sm:px-7 sm:pt-6">
              <p id="restore-notice" hidden role="status" class="mb-4 rounded-xl bg-primary/5 px-4 py-2.5 text-xs font-medium text-primary">
                <Check class="mr-1.5 inline h-3.5 w-3.5" aria-hidden="true" />
                Data terakhir dipulihkan.
              </p>

              <!-- step 1: kondisi keuangan -->
              <div id="step-1" tabindex="-1" class="animate-in fade-in duration-150 outline-none">
                <h2 class="text-xl font-bold tracking-tight text-foreground sm:text-2xl">
                  Kondisi keuangan kamu
                </h2>
                <p class="mt-1 text-sm text-muted-foreground">
                  Isi penghasilan, cicilan saat ini, dan pengeluaran bulanan.
                </p>

                <div class="mt-4">
                  <div class="flex items-center justify-between gap-2">
                    <label for="income" class="text-sm font-medium text-foreground">
                      Penghasilan per bulan
                    </label>
                  </div>
                  <div class={cn(moneyWrapCls, 'mt-2')}>
                    <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-lg font-semibold text-muted-foreground" aria-hidden="true">Rp</span>
                    <input
                      id="income"
                      type="text"
                      inputmode="numeric"
                      autocomplete="off"
                      placeholder="0"
                      data-money-input
                      class="h-14 w-full rounded-xl bg-transparent pl-12 pr-4 text-2xl font-bold text-foreground outline-none placeholder:text-muted-foreground"
                    />
                  </div>
                  <p id="error-income" hidden class="mt-2 text-sm font-medium text-[#ef4444]" aria-live="polite">
                    Masukkan penghasilan bulananmu terlebih dahulu.
                  </p>
                </div>

                <div class="mt-5">
                  <div class="flex items-center justify-between gap-2">
                    <label for="existing" class="text-sm font-medium text-foreground">
                      Cicilan bulanan saat ini
                    </label>
                    <button
                      type="button"
                      id="toggle-existing-detail"
                      aria-expanded="false"
                      data-detail-toggle="existing-detail"
                      class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-semibold text-primary transition-colors hover:bg-primary/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50"
                    >
                      <Plus class="h-3.5 w-3.5" aria-hidden="true" />
                      <span id="toggle-existing-label">Isi lebih detail</span>
                      <ChevronDown class="hidden h-3.5 w-3.5" aria-hidden="true" />
                    </button>
                  </div>
                  <div class={cn(moneyWrapCls, 'mt-2')}>
                    <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-lg font-semibold text-muted-foreground" aria-hidden="true">Rp</span>
                    <input
                      id="existing"
                      type="text"
                      inputmode="numeric"
                      autocomplete="off"
                      placeholder="0"
                      data-money-input
                      data-summary="existing-detail"
                      class="h-14 w-full rounded-xl bg-transparent pl-12 pr-4 text-2xl font-bold text-foreground outline-none placeholder:text-muted-foreground"
                    />
                  </div>
                  <div id="existing-detail" hidden class="mt-3 grid gap-2 sm:grid-cols-2">
                    {[
                      { id: 'existing-kpr', label: 'KPR / Rumah', icon: Home },
                      { id: 'existing-mobil', label: 'Mobil', icon: Car },
                      { id: 'existing-motor', label: 'Motor', icon: Bike },
                      { id: 'existing-kartu', label: 'Kartu kredit', icon: CreditCard },
                      { id: 'existing-lain', label: 'Pinjaman lain', icon: File },
                    ].map((field) => {
                      const Component = field.icon;
                      return (
                        <label class="block cursor-pointer rounded-xl border border-border bg-muted/40 px-3 py-1 transition-colors hover:border-primary/40 hover:bg-muted/60 focus-within:border-primary/60">
                          <span class="flex items-center gap-2">
                            <Component class="h-[18px] w-[18px] shrink-0 text-primary/70" aria-hidden="true" />
                            <span class="min-w-0 flex-1 leading-tight text-[13px] font-medium text-foreground">{field.label}</span>
                          </span>
                          <span class="mt-1 flex items-center gap-1 pl-[26px]">
                            <span class="shrink-0 text-sm font-medium text-muted-foreground" aria-hidden="true">Rp</span>
                            <input
                              id={field.id}
                              type="text"
                              inputmode="numeric"
                              autocomplete="off"
                              placeholder="0"
                              data-money-input
                              data-detail={field.id}
                              data-detail-group="existing-detail"
                              class="h-7 w-full min-w-0 flex-1 bg-transparent text-sm font-semibold text-foreground outline-none placeholder:text-muted-foreground"
                            />
                          </span>
                        </label>
                      );
                    })}
                  </div>
                </div>

                <div class="mt-5">
                  <div class="flex items-center justify-between gap-2">
                    <label for="expenses" class="text-sm font-medium text-foreground">
                      Pengeluaran bulanan
                    </label>
                    <button
                      type="button"
                      data-detail-toggle="expenses-detail"
                      aria-expanded="false"
