          max-width: 512px;
          margin-top: 0;
          margin-bottom: 0;
          margin-inline: auto;
        }
      }
      @media (max-width: 352px) {
        [data-detail-toggle] {
          padding-inline: 0.375rem;
          gap: 0.125rem;
        }
      }

      #bottom-sheet {
        height: min(90vh, 760px);
        height: min(90dvh, 760px);
        max-height: 90vh;
        max-height: 90dvh;
      }

      @media (min-width: 768px) {
        #bottom-sheet {
          inset: 0;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 24px 16px;
          height: auto;
          max-height: none;
          border: 0;
          border-radius: 0;
          background: transparent;
          box-shadow: none;
          transition:
            opacity 250ms ease,
            transform 250ms ease;
        }
        #bottom-sheet.translate-y-full {
          opacity: 0;
          transform: translateY(16px) scale(0.98);
        }
        #bottom-sheet.translate-y-0 {
          opacity: 1;
          transform: none;
        }
        #wizard-shell {
          width: 100%;
          height: auto;
          max-width: 520px;
          max-height: min(720px, calc(100vh - 48px));
          max-height: min(720px, calc(100dvh - 48px));
          overflow: hidden;
          border: 1px solid var(--color-border);
          border-radius: 20px;
          background: var(--color-background);
          box-shadow: 0 24px 80px rgba(0, 0, 0, 0.2);
        }
        #sheet-handle {
          display: none;
        }
        #sheet-backdrop {
          background: rgba(0, 0, 0, 0.35);
          -webkit-backdrop-filter: blur(2px);
          backdrop-filter: blur(2px);
        }
      }
    </style>

    <script>
      import { formatPercentage, formatRupiah } from '../../../lib/calculator/engine';
      import { buildWhatsappUrl, calculateCampaignScenario } from '../../../lib/campaign/campaign-scenario';
      import {
        buildSimulationSnapshot,
        readSimulationSnapshots,
        removeSimulationSnapshot,
        saveSimulationSnapshot,
      } from '../../../lib/campaign/simulation-snapshot';
      import type { CampaignSimulationSnapshot } from '../../../lib/campaign/simulation-snapshot';
      import {
        debtRatioRange,
        expenseRange,
        incomeRange,
        installmentRange,
        remainingIncomeRange,
        resultCategory,
        trackEvent,
      } from '../../../lib/analytics';
      import type { FinancialCalculationResult } from '../../../lib/calculator/engine';

      type ResultCategory = 'healthy' | 'warning' | 'critical' | 'negative_balance';

      type FundingMode = 'promo' | 'floating' | 'syariah';

      interface CampaignConfig {
        price: number;
        priceLabel: string;
        annualInterestRate: number;
        promoInterest?: number;
        promoPeriodYears?: number;
        floatingInterest?: number;
        syariahMargin?: number;
        tenorPresetsMonths: number[];
        defaultTenorMonths: number;
        whatsapp: string;
        whatsappMessage: string;
        marketerSlug: string;
        marketerName: string;
        campaignSlug: string;
        campaignName: string;
        developerName?: string;
        template: string;
        campaignType: string;
        propertyType: string;
      }

      interface WizardState {
        step: number;
        income: number;
        existing: number;
        expenses: number;
        interest: number;
        hasDp: boolean;
        dp: number;
        tenorMonths: number;
        fundingMode?: FundingMode;
        installmentDetails?: Record<string, number>;
        expenseDetails?: Record<string, number>;
      }

      const rawConfig = document.body.dataset.campaignConfig;
      const config = (rawConfig ? JSON.parse(rawConfig) : {}) as unknown as CampaignConfig;

      const numberFormat = new Intl.NumberFormat('id-ID');
      const dateTimeFormat = new Intl.DateTimeFormat('id-ID', {
        dateStyle: 'medium',
        timeStyle: 'short',
      });
      const interestFormat = new Intl.NumberFormat('id-ID', {
        minimumFractionDigits: 1,
        maximumFractionDigits: 1,
      });
      const STORAGE_VERSION = 1;
      const INTEREST_STEP = 0.5;
      const INTEREST_MIN = 0;
      const INTEREST_MAX = 20;
      const DP_STEP = 1_000_000;
      const chipStyles: Record<
        ResultCategory,
        { label: string; className: string }
      > = {
        healthy: { label: 'Masih cukup seimbang', className: 'bg-emerald-100 text-emerald-800' },
        warning: { label: 'Perlu dipertimbangkan lagi', className: 'bg-amber-100 text-amber-800' },
        critical: { label: 'Beban bulanan cukup berat', className: 'bg-red-100 text-red-700' },
        negative_balance: { label: 'Beban melebihi penghasilan', className: 'bg-red-100 text-red-700' },
      };

      const totalSteps = 2;
      let currentStep = 1;
      let selectedTenor = config.defaultTenorMonths;
      let fundingMode: FundingMode = 'promo';
      const modeRates: Record<FundingMode, number | null> = {
        promo: config.promoInterest ?? config.annualInterestRate,
        floating: config.floatingInterest ?? config.annualInterestRate,
        syariah: config.syariahMargin ?? null,
      };
      let interestRate = modeRates.promo ?? config.annualInterestRate;
      let hasDp = true;
      let dpValue = Math.min(config.price, Math.round(config.price * 0.1 / 1_000_000) * 1_000_000);
      let lastStatus: ResultCategory | 'none' = 'none';
      let saveTimer: number | undefined;
      let calculatorStarted = false;
      let calculatorCompleted = false;
      let viewFired = false;

      const wizardBack = document.getElementById('wizard-back') as HTMLButtonElement | null;
      const restoreNotice = document.getElementById('restore-notice') as HTMLElement | null;
      const stepEls: Record<number, HTMLElement> = {
        1: document.getElementById('step-1') as HTMLElement,
        2: document.getElementById('step-2') as HTMLElement,
      };
      const step1Next = document.getElementById('step1-next') as HTMLButtonElement | null;
      const wizardPrimaryFooter = document.getElementById('wizard-primary-footer') as HTMLElement | null;
      const incomeError = document.getElementById('error-income') as HTMLElement | null;
      const dpSlider = document.getElementById('dp-slider') as HTMLInputElement | null;
      const dpValueEl = document.getElementById('dp-value') as HTMLElement | null;
      const dp4ValueEl = document.getElementById('dp4-value') as HTMLElement | null;
      const dp4Slider = document.getElementById('dp4-slider') as HTMLInputElement | null;
      const dp4Region = document.getElementById('dp4-region') as HTMLElement | null;
      const dp4Toggle = document.getElementById('dp4-toggle') as HTMLButtonElement | null;
      const dpRegion = document.getElementById('dp-region') as HTMLElement | null;
      const waCta = document.getElementById('wa-cta') as HTMLAnchorElement | null;
      const saveSimulationBtn = document.getElementById('save-simulation-btn') as HTMLButtonElement | null;

      const bottomSheet = document.getElementById('bottom-sheet') as HTMLElement | null;
      const sheetBackdrop = document.getElementById('sheet-backdrop') as HTMLElement | null;
      const sheetScroll = document.getElementById('wizard') as HTMLElement | null;
      const sheetHandle = document.getElementById('sheet-handle') as HTMLElement | null;
      const photoExpand = document.getElementById('photo-expand') as HTMLButtonElement | null;
      let sheetOpen = false;
      let lastTrigger: HTMLElement | null = null;

      function openSheet(): void {
        sheetOpen = true;
        if (photoExpand) photoExpand.hidden = true;
        if (bottomSheet) {
          bottomSheet.style.transform = '';
          bottomSheet.classList.remove('translate-y-full');
          bottomSheet.classList.add('translate-y-0');
        }
        if (sheetBackdrop) {
          sheetBackdrop.classList.remove('pointer-events-none', 'opacity-0');
          sheetBackdrop.classList.add('opacity-100');
        }
        document.body.style.overflow = 'hidden';
        if (sheetScroll) sheetScroll.scrollTop = 0;
        const incomeInput = document.getElementById('income') as HTMLElement | null;
        (incomeInput ?? bottomSheet)?.focus({ preventScroll: true });
      }

      function closeSheet(): void {
        sheetOpen = false;
        if (photoExpand) photoExpand.hidden = false;
        if (bottomSheet) {
          bottomSheet.style.transform = '';
          bottomSheet.classList.remove('translate-y-0');
          bottomSheet.classList.add('translate-y-full');
        }
        if (sheetBackdrop) {
          sheetBackdrop.classList.add('pointer-events-none', 'opacity-0');
          sheetBackdrop.classList.remove('opacity-100');
        }
        document.body.style.overflow = '';
        if (lastTrigger?.isConnected) lastTrigger.focus({ preventScroll: true });
      }

      // ---- bottom sheet gestures / a11y ----

      let dragPointer: number | null = null;
      let dragStartY = 0;
      let dragDy = 0;

      function onSheetDragMove(event: PointerEvent): void {
        if (dragPointer === null || !bottomSheet) return;
        dragDy = Math.max(0, event.clientY - dragStartY);
        bottomSheet.style.transform = `translateY(${dragDy}px)`;
      }

      function onSheetDragEnd(): void {
        if (dragPointer === null || !bottomSheet) return;
        dragPointer = null;
        if (dragDy > 96) {
          closeSheet();
        } else {
          bottomSheet.style.transform = '';
        }
        dragDy = 0;
      }

      sheetHandle?.addEventListener('pointerdown', (event) => {
        dragPointer = event.pointerId;
        dragStartY = event.clientY;
        dragDy = 0;
        sheetHandle.setPointerCapture(event.pointerId);
      });
      sheetHandle?.addEventListener('pointermove', onSheetDragMove);
      sheetHandle?.addEventListener('pointerup', onSheetDragEnd);
      sheetHandle?.addEventListener('pointercancel', onSheetDragEnd);

      sheetBackdrop?.addEventListener('click', closeSheet);

      bottomSheet?.addEventListener('click', (event) => {
        if (event.target === bottomSheet) closeSheet();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && sheetOpen) {
          event.preventDefault();
          closeSheet();
        }
      });

      document.getElementById('sheet-close')?.addEventListener('click', closeSheet);

      // ---- property photo carousel ----

      function initCarousel(): void {
        const track = document.getElementById('photo-carousel') as HTMLElement | null;
        if (!track) return;

        const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-photo-dot]'));
        const prevBtn = document.getElementById('photo-prev') as HTMLButtonElement | null;
        const nextBtn = document.getElementById('photo-next') as HTMLButtonElement | null;
        const slides = Array.from(track.children) as HTMLElement[];
        let current = 0;

        const { scrollWidth, clientWidth } = track;
        if (scrollWidth <= clientWidth) return;
        const carousel: HTMLElement = track;

        const slideCount = slides.length;

        function syncDots(): void {
          carousel.dataset.slide = String(current);
          dots.forEach((dot, index) => {
            const active = index === current;
            dot.classList.toggle('bg-primary', active);
            dot.classList.toggle('bg-foreground/25', !active);
            dot.classList.toggle('w-4', active);
            dot.classList.toggle('w-1.5', !active);
          });
          if (prevBtn) prevBtn.disabled = current === 0;
          if (nextBtn) nextBtn.disabled = current === slideCount - 1;
        }

        function goToSlide(index: number): void {
          current = Math.min(slideCount - 1, Math.max(0, index));
          track?.scrollTo({ left: current * clientWidth, behavior: 'smooth' });
          syncDots();
        }

        track.addEventListener('scroll', () => {
          const index = Math.round(track.scrollLeft / clientWidth);
          if (index !== current) {
            current = index;
            syncDots();
          }
        });

        dots.forEach((dot) => {
          dot.addEventListener('click', () => goToSlide(Number(dot.dataset.photoDot) || 0));
        });
        prevBtn?.addEventListener('click', () => goToSlide(current - 1));
        nextBtn?.addEventListener('click', () => goToSlide(current + 1));

        syncDots();
      }

      initCarousel();

      // ---- fullscreen photo viewer ("Lihat foto penuh") ----

      function initImageViewer(): void {
        const viewer = document.getElementById('photo-viewer') as HTMLElement | null;
        const track = document.getElementById('photo-viewer-track') as HTMLElement | null;
        const openBtn = document.getElementById('photo-expand') as HTMLButtonElement | null;
        const closeBtn = document.getElementById('photo-viewer-close') as HTMLButtonElement | null;
        const prevBtn = document.getElementById('photo-viewer-prev') as HTMLButtonElement | null;
        const nextBtn = document.getElementById('photo-viewer-next') as HTMLButtonElement | null;
        const cta = document.getElementById('photo-viewer-cta') as HTMLButtonElement | null;
        const counter = document.getElementById('photo-viewer-counter') as HTMLElement | null;
        const slides = track
          ? Array.from(track.querySelectorAll<HTMLElement>('[data-viewer-slide]'))
          : [];
        const slideCount = slides.length;
        if (!viewer || !track || !openBtn || !closeBtn || slideCount === 0) return;
        const viewerEl: HTMLElement = viewer;
        const trackEl: HTMLElement = track;
        const openBtnEl: HTMLButtonElement = openBtn;
        const closeBtnEl: HTMLButtonElement = closeBtn;

        let current = 0;

        function goToSlide(index: number): void {
          current = Math.min(slideCount - 1, Math.max(0, index));
          trackEl.scrollTo({ left: current * trackEl.clientWidth, behavior: 'smooth' });
          sync();
        }

        function sync(): void {
          if (counter) counter.textContent = `${current + 1} / ${slideCount}`;
          if (prevBtn) prevBtn.disabled = current === 0;
          if (nextBtn) nextBtn.disabled = current === slideCount - 1;
        }

        function open(): void {
          const mainTrack = document.getElementById('photo-carousel') as HTMLElement | null;
          current = Math.min(
            slideCount - 1,
            Math.max(0, Number(mainTrack?.dataset.slide ?? 0) || 0),
          );
          viewerEl.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          trackEl.scrollLeft = current * trackEl.clientWidth;
          sync();
          closeBtnEl.focus();
        }

        function close(): void {
          viewerEl.classList.add('hidden');
          document.body.style.overflow = '';
          openBtnEl.focus();
        }

        openBtnEl.addEventListener('click', open);
        closeBtnEl.addEventListener('click', close);
        cta?.addEventListener('click', close);
        prevBtn?.addEventListener('click', () => goToSlide(current - 1));
        nextBtn?.addEventListener('click', () => goToSlide(current + 1));

        document.addEventListener('keydown', (event) => {
          if (viewerEl.classList.contains('hidden')) return;
          if (event.key === 'Escape') {
            event.preventDefault();
            close();
          }
        });

        trackEl.addEventListener('scroll', () => {
          if (trackEl.clientWidth === 0) return;
          const index = Math.round(trackEl.scrollLeft / trackEl.clientWidth);
          if (index !== current) {
            current = index;
            sync();
          }
        });
      }

      initImageViewer();

      // ---- money formatting (reuses CalculatorWizard approach) ----

      function formatMoneyInput(input: HTMLInputElement): void {
        const caretDigits = input.value.slice(0, input.selectionStart ?? 0).replace(/\D/g, '').length;
        const raw = input.value.replace(/\D/g, '').replace(/^0+(?=\d)/, '');
        const formatted = raw ? raw.replace(/\B(?=(\d{3})+(?!\d))/g, '.') : '';
        input.dataset.value = raw;
        input.value = formatted;
        let digits = 0;
        let pos = 0;
        while (pos < formatted.length && digits < caretDigits) {
          if (/\d/.test(formatted[pos])) digits += 1;
          pos += 1;
        }
        input.setSelectionRange(pos, pos);
      }

      function readNumber(id: string): number {
        const el = document.getElementById(id) as HTMLInputElement | null;
        if (!el) return 0;
        const raw = el.dataset.value ?? '';
        return raw ? parseFloat(raw) || 0 : 0;
      }

      function setRupiahInput(id: string, value: number): void {
        const el = document.getElementById(id) as HTMLInputElement | null;
        if (!el || value < 0) return;
        el.value = value ? numberFormat.format(value) : '';
        el.dataset.value = String(Math.round(value));
      }

      // ---- storage ----

      function storageKey(): string {
        return `cekdulu:campaign:${config.campaignSlug}:wizard:v${STORAGE_VERSION}`;
      }

      function readStored(): WizardState | null {
        try {
          const raw = window.localStorage.getItem(storageKey());
          if (!raw) return null;
          const envelope = JSON.parse(raw) as { version?: number; data?: Partial<WizardState> };
          if (envelope?.version !== STORAGE_VERSION || !envelope.data) return null;
          return {
            step: Math.min(totalSteps, Math.max(1, Number(envelope.data.step) || 1)),
            income: Number(envelope.data.income) || 0,
            existing: Number(envelope.data.existing) || 0,
            expenses: Number(envelope.data.expenses) || 0,
            interest: Number(envelope.data.interest) || config.annualInterestRate,
            hasDp: Boolean(envelope.data.hasDp),
            dp: Number(envelope.data.dp) || 0,
            tenorMonths:
              Number(envelope.data.tenorMonths) || config.defaultTenorMonths,
            fundingMode:
              envelope.data.fundingMode === 'floating' || envelope.data.fundingMode === 'syariah'
                ? envelope.data.fundingMode
                : 'promo',
            installmentDetails: readDetailMap(envelope.data.installmentDetails as Record<string, number> | undefined),
            expenseDetails: readDetailMap(envelope.data.expenseDetails as Record<string, number> | undefined),
          };
        } catch {
          return null;
        }
      }

      function writeStored(step = currentStep): void {
        try {
          const state: WizardState = {
            step,
            income: readNumber('income'),
            existing: readNumber('existing'),
            expenses: readNumber('expenses'),
            interest: interestRate,
            hasDp,
            dp: dpValue,
            tenorMonths: selectedTenor,
            fundingMode,
            installmentDetails: readDetailGroup('existing-detail'),
            expenseDetails: readDetailGroup('expenses-detail'),
          };
          window.localStorage.setItem(
            storageKey(),
            JSON.stringify({ version: STORAGE_VERSION, updatedAt: new Date().toISOString(), data: state }),
          );
        } catch {
          // Storage penuh / tidak tersedia: simulasi tetap berjalan tanpa autosave.
        }
      }

      function scheduleSave(step?: number): void {
        if (saveTimer) window.clearTimeout(saveTimer);
        saveTimer = window.setTimeout(() => writeStored(step), 300);
      }

      // ---- wizard navigation ----

      function updateProgress(): void {
        if (wizardBack) {
          wizardBack.hidden = currentStep === 1;
        }
      }

      function render(focusStep: boolean): void {
        for (let s = 1; s <= totalSteps; s++) {
          stepEls[s].classList.toggle('hidden', s !== currentStep);
        }
        if (step1Next) step1Next.hidden = currentStep !== 1;
        if (waCta) waCta.hidden = currentStep !== 2;
        if (wizardPrimaryFooter) wizardPrimaryFooter.hidden = currentStep !== 2;
        updateProgress();
        if (currentStep === 2) resetWaScrollGate();
        if (focusStep) stepEls[currentStep].focus({ preventScroll: true });
      }

      function goTo(step: number): void {
        currentStep = Math.min(totalSteps, Math.max(1, step));
        if (sheetScroll) sheetScroll.scrollTop = 0;
        render(true);
        scheduleSave();
      }

      function showRestoreNotice(): void {
        if (!restoreNotice) return;
        restoreNotice.hidden = false;
        window.setTimeout(() => {
          restoreNotice.hidden = true;
        }, 5000);
      }

      function updateWaCtaState(): void {
        if (!waCta || !sheetScroll) return;
        const scrollBottom = sheetScroll.scrollHeight - sheetScroll.clientHeight - sheetScroll.scrollTop;
        const isAtBottom = scrollBottom < 10;
        (waCta as unknown as HTMLButtonElement).disabled = !isAtBottom;
        waCta.style.opacity = isAtBottom ? '1' : '0.5';
        waCta.style.cursor = isAtBottom ? 'pointer' : 'default';
      }

      // ---- calculation ----

      function computeScenario() {
        return calculateCampaignScenario({
          price: config.price,
          annualInterestRate: interestRate,
          downPayment: hasDp ? dpValue : 0,
          tenorMonths: selectedTenor,
          monthlyIncome: readNumber('income'),
          existingInstallments: readNumber('existing'),
          monthlyExpenses: readNumber('expenses'),
        });
      }

      function setText(id: string, value: string): void {
        const el = document.getElementById(id);
        if (el) el.textContent = value;
      }

      function explanationFor(result: FinancialCalculationResult): string {
        const category = resultCategory(result) as ResultCategory;
        if (category === 'negative_balance') {
          return `Total beban per bulan sudah melebihi penghasilanmu (sisa ${formatRupiah(result.remainingAfterDebtAndExpenses)}/bulan). Sebaiknya pikirkan kembali sebelum lanjut mengambil cicilan ini.`;
        }
        const ratio = formatPercentage(result.debtRatio);
        if (category === 'critical') {
          return `Rasio cicilan bulananmu ${ratio} dari penghasilan — jauh lebih tinggi dari acuan umum. Coba tambah DP atau perpanjang tenor agar cicilan turun.`;
        }
        if (category === 'warning') {
          return `Rasio cicilan ${ratio} masih dalam batas yang bisa dipertimbangkan, tapi pastikan sisa uang ${formatRupiah(result.remainingAfterDebtAndExpenses)}/bulan cukup untuk kebutuhan tak terduga.`;
        }
        return `Rasio cicilan ${ratio} dan sisa uang ${formatRupiah(result.remainingAfterDebtAndExpenses)}/bulan setelah semua beban. Kondisi keuanganmu masih cukup seimbang.`;
      }

      function renderResult(): void {
        const scenario = computeScenario();
        const income = readNumber('income');
        const existing = readNumber('existing');
        const expenses = readNumber('expenses');
        const hasBalance = income > 0;
        const syariahPlaceholder = fundingMode === 'syariah' && modeRates.syariah == null;

        if (syariahPlaceholder) {
          setText('est-installment', 'Belum tersedia');
          setText('result-income', hasBalance ? formatRupiah(income) : '—');
          setText('result-existing', existing > 0 ? formatRupiah(existing) : '—');
          setText('result-expense', expenses > 0 ? formatRupiah(expenses) : '—');
          setText('result-kpr', '—');
          setText('result-total-beban', '—');
          setText('result-sisa', '—');
          const chip = document.getElementById('status-chip');
          if (chip) chip.hidden = true;
          const explanation = document.getElementById('result-explanation');
          if (explanation) {
            explanation.hidden = !hasBalance;
            explanation.textContent = hasBalance
              ? 'Kampanye ini belum punya asumsi margin syariah untuk disimulasikan. Tanyakan rincian margin dan akad syariah kepada tim sales sebelum mengambil keputusan.'
              : '';
          }
          renderBalance();
          renderSimHelper();
          if (saveSimulationBtn) saveSimulationBtn.disabled = true;
          updateWhatsapp();
          return;
        }

        const awarenessEl = document.getElementById('awareness-costs');
        if (awarenessEl) awarenessEl.hidden = scenario.remainingAfterDebtAndExpenses < 0;

        setText('est-installment', scenario.principal > 0 ? `${formatRupiah(scenario.monthlyInstallment)}/bulan` : '—');
        setText('result-income', hasBalance ? formatRupiah(income) : '—');
        setText('result-existing', existing > 0 ? formatRupiah(existing) : '—');
        setText('result-kpr', scenario.principal > 0 ? formatRupiah(scenario.monthlyInstallment) : '—');
        setText('result-expense', expenses > 0 ? formatRupiah(expenses) : '—');
        setText('result-total-beban', hasBalance ? `${formatRupiah(existing + scenario.monthlyInstallment + expenses)}/bln` : '—');
        setText('result-sisa', hasBalance ? `${formatRupiah(scenario.remainingAfterDebtAndExpenses)}/bln` : '—');

        const chip = document.getElementById('status-chip');
        if (chip) {
          if (hasBalance) {
            const category = resultCategory(scenario) as ResultCategory;
            const style = chipStyles[category];
            chip.hidden = false;
            chip.className = `mt-2 inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold ${style.className}`;
            const textEl = document.getElementById('status-chip-text');
            if (textEl) textEl.textContent = style.label;
            const okIcon = document.getElementById('status-chip-icon-ok');
            const warnIcon = document.getElementById('status-chip-icon-warn');
            const positive = category === 'healthy';
            if (okIcon) okIcon.toggleAttribute('hidden', !positive);
            if (warnIcon) warnIcon.toggleAttribute('hidden', positive);
            lastStatus = category;
            if (calculatorStarted) markCalculatorComplete(category);
          } else {
            chip.hidden = true;
          }
        }

        const explanation = document.getElementById('result-explanation');
        if (explanation) {
          explanation.hidden = !hasBalance;
          explanation.textContent = hasBalance ? explanationFor(scenario) : '';
        }

        renderBalance();
        renderSimHelper();

        if (saveSimulationBtn) saveSimulationBtn.disabled = !hasBalance;
        updateWhatsapp();
      }

      function renderSimHelper(): void {
        const el = document.getElementById('sim-helper');
        if (!el) return;
        const income = readNumber('income');
        if (income <= 0) {
          el.textContent = '';
          return;
        }
        const scenario = computeScenario();
        const category = resultCategory(scenario) as ResultCategory;
        if (scenario.remainingAfterDebtAndExpenses < 0) {
          el.textContent =
            'Beban bulanan masih berat. Kalau mau, coba sesuaikan DP, tenor, atau bunga untuk melihat skenario lain.';
          return;
        }
        if (category === 'healthy' || category === 'warning') {
          el.textContent = 'Masih ingin melihat skenario lain?';
        } else {
          el.textContent =
            'Beban bulanan masih berat. Kalau mau, coba sesuaikan DP, tenor, atau bunga untuk melihat skenario lain.';
        }
      }

      function renderBalance(): void {
        const income = readNumber('income');
        const existing = readNumber('existing');
        const expenses = readNumber('expenses');
        const scenario = computeScenario();
        const beban = existing + scenario.monthlyInstallment + expenses;
        const sisa = scenario.remainingAfterDebtAndExpenses;
        const bebanEl = document.getElementById('balance-beban') as HTMLElement | null;
        const sisaEl = document.getElementById('balance-sisa') as HTMLElement | null;
        const bebanValue = document.getElementById('balance-beban-value') as HTMLElement | null;
        const sisaValue = document.getElementById('balance-sisa-value') as HTMLElement | null;
        if (!bebanEl || !sisaEl || !bebanValue || !sisaValue) return;

        if (income <= 0) {
          bebanEl.style.width = '0%';
          sisaEl.style.width = '0%';
          bebanValue.textContent = '—';
          sisaValue.textContent = '—';
          return;
        }

        if (fundingMode === 'syariah' && modeRates.syariah == null) {
          bebanEl.style.width = '0%';
          sisaEl.style.width = '0%';
          bebanValue.textContent = '—';
          sisaValue.textContent = '—';
          return;
        }

        const bebanPct = Math.min(100, Math.max(2, (beban / income) * 100));
        const sisaPct = sisa >= 0 ? 100 - Math.min(100, (beban / income) * 100) : 0;
        bebanEl.style.width = `${Math.min(100, bebanPct)}%`;
        sisaEl.style.width = `${Math.max(0, Math.min(100, sisaPct))}%`;
        bebanValue.textContent = formatRupiah(beban);
        sisaValue.textContent = formatRupiah(sisa);
      }

      function updateWhatsapp(): void {
        if (!waCta) return;
        const cleanUrl = `${window.location.origin}/c/${config.marketerSlug}/${config.campaignSlug}`;
        const href = buildWhatsappUrl({
          number: config.whatsapp,
          baseMessage: config.whatsappMessage,
          url: cleanUrl,
        });
        waCta.href = href;
      }

      // ---- WhatsApp CTA scroll gate ----

      let hasReachedBottom = false;

      function setWaEnabled(enabled: boolean): void {
        if (!waCta) return;
        const disabled = !enabled;
        waCta.setAttribute('aria-disabled', String(disabled));
        waCta.tabIndex = disabled ? -1 : 0;
        waCta.classList.toggle('opacity-40', disabled);
        waCta.classList.toggle('cursor-not-allowed', disabled);
        waCta.classList.toggle('cursor-pointer', enabled);
      }

      function resetWaScrollGate(): void {
        hasReachedBottom = false;
        setWaEnabled(false);
      }

      function initWaScrollGate(): void {
        if (!sheetScroll) return;
        sheetScroll.addEventListener('scroll', () => {
          if (hasReachedBottom) return;
          const { scrollTop, scrollHeight, clientHeight } = sheetScroll;
          if (scrollTop + clientHeight >= scrollHeight - 12) {
            hasReachedBottom = true;
            setWaEnabled(true);
          }
          updateWaCtaState();
        });
      }

      // ---- analytics ----

      function campaignContext(): Record<string, string> {
        return {
          marketer_slug: config.marketerSlug,
          campaign_slug: config.campaignSlug,
          campaign_type: config.campaignType,
          property_type: config.propertyType,
        };
      }

      function markCalculatorStart(): void {
        if (calculatorStarted) return;
        calculatorStarted = true;
        trackEvent('calculator_start', {
          ...campaignContext(),
          template: config.template,
          calculator_type: 'affordability',
        });
      }

      function markCalculatorComplete(category: ResultCategory): void {
        if (calculatorCompleted) return;
        calculatorCompleted = true;
        const result = computeScenario();
        const params: Record<string, string> = {
          ...campaignContext(),
          template: config.template,
          calculator_type: 'affordability',
          result_status: category,
          income_range: incomeRange(readNumber('income')),
          existing_debt_range: installmentRange(readNumber('existing')),
          monthly_expense_range: expenseRange(readNumber('expenses')),
          debt_ratio_range: debtRatioRange(result.debtRatio),
          remaining_income_range: remainingIncomeRange(result.remainingAfterDebtAndExpenses),
        };
        trackEvent('calculator_complete', params);
      }

      function fireView(): void {
        if (viewFired) return;
        viewFired = true;
        trackEvent('campaign_view', {
          ...campaignContext(),
          template: config.template,
        });
      }

      // ---- save / restore simulation ----

      function saveSimulation(): void {
        const scenario = computeScenario();
        if (readNumber('income') <= 0) return;
        const snapshot = buildSimulationSnapshot({
          campaign: {
            marketerSlug: config.marketerSlug,
            marketerName: config.marketerName,
            campaignSlug: config.campaignSlug,
            campaignName: config.campaignName,
            developerName: config.developerName,
            template: config.template,
          },
          params: {
            price: config.price,
            priceLabel: config.priceLabel,
            annualInterestRate: config.annualInterestRate,
          },
          inputs: {
            downPayment: dpValue,
            tenorMonths: selectedTenor,
            monthlyIncome: readNumber('income'),
            existingInstallments: readNumber('existing'),
            monthlyExpenses: readNumber('expenses'),
            simulationInterestRate: interestRate,
          },
          result: {
            monthlyInstallment: scenario.monthlyInstallment,
            totalMonthlyDebt: scenario.totalMonthlyDebt,
            debtRatio: scenario.debtRatio,
            remainingAfterDebtAndExpenses: scenario.remainingAfterDebtAndExpenses,
          },
        });
        const ok = saveSimulationSnapshot(config.marketerSlug, config.campaignSlug, snapshot);
        if (!ok) return;
        const note = document.getElementById('saved-note');
        if (note) {
          note.hidden = false;
          window.setTimeout(() => {
            note.hidden = true;
          }, 4000);
        }
        renderSavedList();
        trackEvent('simulation_saved', {
          ...campaignContext(),
          template: config.template,
          result_status: lastStatus,
        });
      }

      function restoreSimulation(snapshot: CampaignSimulationSnapshot): void {
        setRupiahInput('income', snapshot.inputs.monthlyIncome);
        setRupiahInput('existing', snapshot.inputs.existingInstallments);
        setRupiahInput('expenses', snapshot.inputs.monthlyExpenses);
        clearDetailGroup('existing-detail');
        clearDetailGroup('expenses-detail');
        interestRate = snapshot.inputs.simulationInterestRate || config.annualInterestRate;
        hasDp = snapshot.inputs.downPayment > 0;
        dpValue = snapshot.inputs.downPayment;
        selectedTenor =
          config.tenorPresetsMonths.includes(snapshot.inputs.tenorMonths)
            ? snapshot.inputs.tenorMonths
            : config.defaultTenorMonths;
        syncDpUI();
        syncInterestUI();
        syncTenorUI();
        fundingMode = 'promo';
        modeRates.promo = interestRate;
        syncFundingUI();
        renderResult();
        writeStored(2);
        openSheet();
        goTo(2);
      }

      function renderSavedList(): void {
        const list = readSimulationSnapshots(config.marketerSlug, config.campaignSlug);
        const section = document.getElementById('saved-section');
        const container = document.getElementById('saved-simulations');
        if (!section || !container) return;

        section.hidden = list.length === 0;
        container.textContent = '';

        for (const snapshot of list) {
          const item = document.createElement('li');
          item.className =
            'flex flex-col gap-3 rounded-xl border border-border bg-muted/40 p-4 sm:flex-row sm:items-center sm:justify-between';

          const info = document.createElement('div');
          const title = document.createElement('p');
          title.className = 'text-sm font-semibold text-foreground';
          title.textContent = [snapshot.campaign.campaignName, snapshot.campaign.developerName]
            .filter((part): part is string => Boolean(part))
            .join(' · ');
          const meta = document.createElement('p');
          meta.className = 'mt-0.5 text-xs text-muted-foreground';
          meta.textContent = `Bunga ${interestFormat.format(snapshot.inputs.simulationInterestRate || config.annualInterestRate)}% · DP ${formatRupiah(snapshot.inputs.downPayment)} · ${snapshot.inputs.tenorMonths / 12} tahun · Cicilan ${formatRupiah(snapshot.result.monthlyInstallment)}/bln`;
          const savedAt = document.createElement('p');
          savedAt.className = 'mt-1 text-xs text-muted-foreground';
          savedAt.textContent = `Disimpan ${dateTimeFormat.format(new Date(snapshot.savedAt))}`;
          info.append(title, meta, savedAt);

          const actions = document.createElement('div');
          actions.className = 'flex gap-2';

          const restoreBtn = document.createElement('button');
          restoreBtn.type = 'button';
          restoreBtn.textContent = 'Muat';
          restoreBtn.className =
            'inline-flex cursor-pointer items-center justify-center gap-1.5 rounded-full border border-border bg-background px-4 py-2 text-sm font-semibold text-foreground transition-colors hover:bg-muted outline-none focus-visible:ring-3 focus-visible:ring-ring/50';
          restoreBtn.addEventListener('click', () => restoreSimulation(snapshot));

          const deleteBtn = document.createElement('button');
          deleteBtn.type = 'button';
          deleteBtn.textContent = 'Hapus';
          deleteBtn.className =
            'inline-flex cursor-pointer items-center justify-center gap-1.5 rounded-full border border-border bg-background px-4 py-2 text-sm font-semibold text-foreground transition-colors hover:bg-muted outline-none focus-visible:ring-3 focus-visible:ring-ring/50';
          deleteBtn.addEventListener('click', () => {
            removeSimulationSnapshot(config.marketerSlug, config.campaignSlug, snapshot.id);
            renderSavedList();
          });

          actions.append(restoreBtn, deleteBtn);
          item.append(info, actions);
          container.appendChild(item);
        }
      }

      // ---- step 3 & step 4 parameter controls ----

      function renderIfResult(): void {
        if (currentStep === 2) renderResult();
      }

      function fundingNote(mode: FundingMode): string {
        if (mode === 'promo') {
          if (config.promoInterest != null && config.promoPeriodYears) {
            return `Bunga promo ${interestFormat.format(config.promoInterest)}% selama ${config.promoPeriodYears} tahun.`;
          }
          return 'Bunga promo ditetapkan bank dan dapat berlaku untuk periode tertentu sesuai kebijakan bank.';
        }
        if (mode === 'floating') {
          return 'Bunga floating dapat berubah selama masa pembiayaan, sehingga cicilan bisa berubah.';
        }
        if (modeRates.syariah != null) {
          return `Simulasi syariah memakai asumsi margin ${interestFormat.format(modeRates.syariah)}% per tahun.`;
        }
        return 'Simulasi syariah membutuhkan parameter margin/asumsi pembiayaan dari marketer.';
      }

      function estTenorLabel(): string {
        const years = selectedTenor / 12;
        if (fundingMode === 'promo') {
          if (config.promoInterest == null) {
            return `Tenor ${years} tahun`;
          }
          if (config.promoPeriodYears != null) {
            return `selama ${Math.min(Math.max(1, config.promoPeriodYears), years)} tahun`;
          }
          return 'selama jangka waktu terbatas yang ditetapkan bank';
        }
        return `Tenor ${years} tahun`;
      }

      function updateEstTenorLabel(): void {
        const estTenor = document.getElementById('est-tenor');
        if (estTenor) estTenor.textContent = estTenorLabel();
      }

      function syncFundingUI(): void {
        document
          .querySelectorAll<HTMLButtonElement>('[data-funding-mode]')
          .forEach((btn) => {
            const active = btn.dataset.fundingMode === fundingMode;
            btn.setAttribute('aria-pressed', String(active));
            btn.classList.toggle('border-primary', active);
            btn.classList.toggle('bg-primary', active);
            btn.classList.toggle('text-primary-foreground', active);
            btn.classList.toggle('border-border', !active);
            btn.classList.toggle('bg-card', !active);
            btn.classList.toggle('text-muted-foreground', !active);
          });
        const noteEl = document.getElementById('funding-note');
        if (noteEl) noteEl.textContent = fundingNote(fundingMode);
        const syariahPlaceholder = fundingMode === 'syariah' && modeRates.syariah == null;
        for (const id of ['interest-group', 'interest4-group']) {
          const group = document.getElementById(id);
          if (group) group.hidden = syariahPlaceholder;
        }
        updateEstTenorLabel();
      }

      function selectFundingMode(mode: FundingMode): void {
        if (mode === fundingMode) return;
        fundingMode = mode;
        if (mode !== 'syariah' || modeRates.syariah != null) {
          interestRate = modeRates[mode] ?? config.annualInterestRate;
        }
        syncInterestUI();
        syncFundingUI();
        scheduleSave();
        renderIfResult();
      }

      function syncInterestUI(): void {
        const text = `${interestFormat.format(interestRate)}%`;
        for (const id of ['interest-value', 'interest4-value']) {
          const btn = document.getElementById(id) as HTMLButtonElement | null;
          if (btn) btn.textContent = text;
        }
        const input = document.getElementById('interest-input') as HTMLInputElement | null;
        if (input) input.value = String(interestRate).replace('.', ',');
        const input4 = document.getElementById('interest4-input') as HTMLInputElement | null;
        if (input4) input4.value = String(interestRate).replace('.', ',');
      }

      function commitInterest(value: number): void {
        if (fundingMode === 'syariah' && modeRates.syariah == null) return;
        interestRate = Math.round(Math.min(INTEREST_MAX, Math.max(INTEREST_MIN, value)) * 100) / 100;
        modeRates[fundingMode] = interestRate;
        syncInterestUI();
        syncFundingUI();
        scheduleSave();
        renderIfResult();
      }

      function changeInterest(delta: number): void {
        commitInterest(interestRate + delta);
      }

      function syncDpValues(): void {
        const text = dpValue > 0 ? formatRupiah(dpValue) : 'Rp 0';
        if (dpValueEl) dpValueEl.textContent = text;
        if (dp4ValueEl) dp4ValueEl.textContent = text;
      }

      function syncDpSliders(): void {
        const val = String(Math.min(dpValue, config.price));
        if (dpSlider) dpSlider.value = val;
        if (dp4Slider && hasDp) dp4Slider.value = val;
      }

      function syncDpPresets(): void {
        document.querySelectorAll<HTMLButtonElement>('[data-dp-preset]').forEach((button) => {
          const pct = Number(button.dataset.dpPreset);
          const presetValue = Math.min(config.price, Math.round(config.price * pct / 1_000_000) * 1_000_000);
          const active = hasDp && dpValue === presetValue;
          button.setAttribute('aria-pressed', String(active));
          button.classList.toggle('border-primary', active);
          button.classList.toggle('bg-primary/10', active);
          button.classList.toggle('text-primary', active);
          button.classList.toggle('border-border', !active);
          button.classList.toggle('bg-card', !active);
          button.classList.toggle('text-muted-foreground', !active);
        });
      }

      function syncDpUI(): void {
        const noneBtn = document.querySelector('[data-dp-choice="none"]') as HTMLButtonElement | null;
        const setBtn = document.querySelector('[data-dp-choice="set"]') as HTMLButtonElement | null;
        const active = hasDp ? setBtn : noneBtn;
        const inactive = hasDp ? noneBtn : setBtn;
        for (const [btn, isActive] of [
          [active, true],
          [inactive, false],
        ] as [HTMLButtonElement | null, boolean][]) {
          if (!btn) continue;
          btn.setAttribute('aria-pressed', String(isActive));
          btn.classList.toggle('border-primary', isActive);
          btn.classList.toggle('bg-primary/10', isActive);
          btn.classList.toggle('text-primary', isActive);
          btn.classList.toggle('border-border', !isActive);
          btn.classList.toggle('bg-card', !isActive);
          btn.classList.toggle('text-muted-foreground', !isActive);
        }
        if (dpRegion) dpRegion.hidden = !hasDp;
        syncDpSliders();
        syncDpValues();
        syncDpPresets();
        if (dp4Region) dp4Region.hidden = !hasDp;
        if (dp4Toggle) {
          dp4Toggle.setAttribute('aria-pressed', String(hasDp));
          dp4Toggle.textContent = hasDp ? 'Belum ada DP' : 'Ada DP';
        }
      }

      function changeDp(delta: number): void {
        const next = Math.min(config.price, Math.max(0, dpValue + delta));
        dpValue = next;
        syncDpSliders();
        syncDpValues();
        syncDpPresets();
        scheduleSave();
        renderIfResult();
      }

      function syncTenorUI(): void {
        document.querySelectorAll<HTMLButtonElement>('[data-tenor-months]').forEach((button) => {
          const active = Number(button.dataset.tenorMonths) === selectedTenor;
          button.setAttribute('aria-pressed', String(active));
          button.classList.toggle('border-transparent', active);
          button.classList.toggle('bg-primary', active);
          button.classList.toggle('text-primary-foreground', active);
          button.classList.toggle('hover:bg-muted', !active);
          button.classList.toggle('bg-background', !active);
          button.classList.toggle('text-foreground', !active);
          button.classList.toggle('border-border', !active);
        });
        const ageAwareness = document.getElementById('tenor-age-awareness');
        if (ageAwareness) ageAwareness.hidden = selectedTenor < 240;
        updateEstTenorLabel();
      }

      function selectTenor(months: number): void {
        selectedTenor = months;
        syncTenorUI();
        scheduleSave();
      }

      // ---- step 2 detail breakdown sync ----
      // Detail rows are authoritative once non-empty. A summary field is the
      // live total of its detail group; editing the summary directly clears
      // that group's rows to avoid double counting.

      function clearDetailGroup(detailGroup: string): void {
        for (const el of document.querySelectorAll<HTMLInputElement>(`[data-detail-group="${detailGroup}"]`)) {
          delete el.dataset.value;
          el.value = '';
        }
      }

      function syncDetailSummary(detailGroup: string): void {
        const summary = document.querySelector<HTMLInputElement>(`[data-summary="${detailGroup}"]`);
        if (!summary) return;
        const values = Array.from(
          document.querySelectorAll<HTMLInputElement>(`[data-detail-group="${detailGroup}"]`),
        ).map((el) => readNumber(el.id));
        const total = values.reduce((sum, n) => sum + n, 0);
        summary.dataset.value = String(total);
        summary.value = total ? numberFormat.format(total) : '';
      }

      function readDetailGroup(groupId: string): Record<string, number> {
        const out: Record<string, number> = {};
        for (const el of document.querySelectorAll<HTMLInputElement>(`[data-detail-group="${groupId}"]`)) {
          const v = readNumber(el.id);
          if (v > 0) out[el.id] = v;
        }
        return out;
      }

      function applyDetailGroup(groupId: string, values: Record<string, number> | undefined): void {
        if (!values) return;
        let applied = false;
        for (const el of document.querySelectorAll<HTMLInputElement>(`[data-detail-group="${groupId}"]`)) {
          const v = values[el.id] ?? 0;
          if (v > 0) {
            setRupiahInput(el.id, v);
            applied = true;
          }
        }
        if (applied) syncDetailSummary(groupId);
      }

      function readDetailMap(patch: Record<string, number> | undefined): Record<string, number> {
        const out: Record<string, number> = {};
        if (!patch) return out;
        for (const [k, v] of Object.entries(patch)) {
          const n = Number(v);
          if (Number.isFinite(n) && n > 0) out[k] = Math.round(n);
        }
        return out;
      }

      // ---- initialization ----

      function fireViewOnLoad(): void {
        if (document.readyState === 'complete') {
          fireView();
        } else {
          window.addEventListener('load', fireView);
        }
      }

      fireViewOnLoad();

      step1Next?.addEventListener('click', () => {
        markCalculatorStart();
        const income = readNumber('income');
        if (income <= 0) {
          if (incomeError) incomeError.hidden = false;
          document.getElementById('income')?.focus();
          return;
        }
        if (incomeError) incomeError.hidden = true;
        renderResult();
        writeStored(2);
        goTo(2);
      });

      document.getElementById('income')?.addEventListener('input', () => {
        markCalculatorStart();
        if (incomeError) incomeError.hidden = true;
        if (step1Next) step1Next.disabled = readNumber('income') <= 0;
        scheduleSave();
      });

      const simToggle = document.getElementById('sim-toggle');
      const simPanel = document.getElementById('sim-panel');
      const simChevron = document.getElementById('sim-chevron');
      const simHint = document.getElementById('sim-hint');
      if (simToggle && simPanel) {
        simToggle.addEventListener('click', () => {
          const expanding = simPanel.hidden === true;
          simPanel.hidden = !expanding;
          simToggle.setAttribute('aria-expanded', String(expanding));
          simChevron?.classList.toggle('rotate-180', expanding);
          if (simHint) simHint.hidden = expanding;
        });
      }

      document.addEventListener('click', (event) => {
        const el = (event.target as Element | null)?.closest('[data-back]');
        if (el) {
          if (currentStep === 1) {
            closeSheet();
            return;
          }
          goTo(currentStep - 1);
          return;
        }
        const toggle = (event.target as Element | null)?.closest('[data-detail-toggle]');
        if (toggle) {
          const wrapper = toggle.getAttribute('data-detail-toggle');
          const panel = wrapper ? document.getElementById(wrapper) : null;
          if (!panel) return;
          panel.hidden = !panel.hidden;
          toggle.setAttribute('aria-expanded', String(!panel.hidden));
          if (!panel.hidden && panel.id === 'existing-detail') {
            const label = document.getElementById('toggle-existing-label');
            if (label) label.textContent = 'Sembunyikan detail';
          } else {
            const label = document.getElementById('toggle-existing-label');
            if (label) label.textContent = 'Isi lebih detail';
          }
        }
      });

      document.querySelectorAll<HTMLInputElement>('[data-money-input]').forEach((input) => {
        input.addEventListener('input', () => {
          formatMoneyInput(input);
          const summaryGet = input.dataset.summary;
          const detailGroup = input.dataset.detailGroup;
          if (summaryGet) {
            // Editing the summary directly resets that detail group.
            const hasDetail =
              Array.from(
                document.querySelectorAll<HTMLInputElement>(`[data-detail-group="${summaryGet}"]`),
              ).some((el) => readNumber(el.id) > 0);
            if (hasDetail) {
              clearDetailGroup(summaryGet);
            }
          }
          if (detailGroup) {
            syncDetailSummary(detailGroup);
          }
          const isIncome = input.id === 'income';
          if (step1Next && isIncome) step1Next.disabled = readNumber('income') <= 0;
          if (isIncome && incomeError) incomeError.hidden = true;
          scheduleSave();
        });
        input.addEventListener('keydown', (event) => {
          if (event.ctrlKey || event.metaKey || event.altKey) return;
          if (event.key.length > 1 || /[0-9]/.test(event.key)) return;
          event.preventDefault();
        });
      });

      document.querySelectorAll<HTMLButtonElement>('[data-tenor-months]').forEach((button) => {
        button.addEventListener('click', () => {
          markCalculatorStart();
          selectTenor(Number(button.dataset.tenorMonths));
          renderIfResult();
        });
      });

      document.querySelectorAll<HTMLButtonElement>('[data-dp-choice]').forEach((button) => {
        button.addEventListener('click', () => {
          hasDp = button.dataset.dpChoice === 'set';
          if (hasDp && dpSlider && dpValue === 0) {
            dpValue = Math.min(Math.round(config.price * 0.2 / 1_000_000) * 1_000_000, config.price);
          }
          syncDpUI();
          scheduleSave();
          renderIfResult();
        });
      });

      document.querySelectorAll<HTMLButtonElement>('[data-dp-preset]').forEach((button) => {
        button.addEventListener('click', () => {
          const pct = Number(button.dataset.dpPreset);
          hasDp = true;
          dpValue = Math.min(config.price, Math.round(config.price * pct / 1_000_000) * 1_000_000);
          syncDpUI();
          scheduleSave();
          renderIfResult();
        });
      });

      dpSlider?.addEventListener('input', () => {
        dpValue = Math.min(config.price, Math.round((Number(dpSlider.value) || 0) / 1_000_000) * 1_000_000);
        syncDpSliders();
        syncDpValues();
        syncDpPresets();
        scheduleSave();
        renderIfResult();
      });

      document.getElementById('dp-minus')?.addEventListener('click', () => changeDp(-DP_STEP));
      document.getElementById('dp-plus')?.addEventListener('click', () => changeDp(DP_STEP));

      dp4Toggle?.addEventListener('click', () => {
        hasDp = !hasDp;
        if (hasDp && dpValue === 0) {
          dpValue = Math.min(Math.round(config.price * 0.2 / 1_000_000) * 1_000_000, config.price);
        }
        syncDpUI();
        scheduleSave();
        renderIfResult();
      });

      dp4Slider?.addEventListener('input', () => {
        dpValue = Math.min(config.price, Math.round((Number(dp4Slider.value) || 0) / 1_000_000) * 1_000_000);
        syncDpSliders();
        syncDpValues();
        syncDpPresets();
        scheduleSave();
        renderIfResult();
      });

      document.getElementById('dp4-minus')?.addEventListener('click', () => changeDp(-DP_STEP));
      document.getElementById('dp4-plus')?.addEventListener('click', () => changeDp(DP_STEP));

      document.querySelectorAll<HTMLButtonElement>('[data-funding-mode]').forEach((button) => {
        button.addEventListener('click', () => {
          selectFundingMode(button.dataset.fundingMode as FundingMode);
        });
      });

      document.getElementById('interest-minus')?.addEventListener('click', () => changeInterest(-INTEREST_STEP));
      document.getElementById('interest-plus')?.addEventListener('click', () => changeInterest(INTEREST_STEP));

      const interestValueBtn = document.getElementById('interest-value') as HTMLButtonElement | null;
      const interestEditor = document.getElementById('interest-editor') as HTMLElement | null;
      const interestInput = document.getElementById('interest-input') as HTMLInputElement | null;
      const interestApply = document.getElementById('interest-apply') as HTMLButtonElement | null;

      interestValueBtn?.addEventListener('click', () => {
        if (!interestEditor || !interestInput) return;
        interestEditor.hidden = !interestEditor.hidden;
        if (!interestEditor.hidden) {
          interestInput.value = String(interestRate).replace('.', ',');
          interestInput.focus();
          interestInput.select();
        }
      });

      function applyInterestInput(): void {
        const parsed = parseFloat((interestInput?.value ?? '').replace(',', '.'));
        if (Number.isFinite(parsed)) {
          commitInterest(parsed);
        }
        syncInterestUI();
        if (interestEditor) interestEditor.hidden = true;
      }

      interestApply?.addEventListener('click', applyInterestInput);
      interestInput?.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          applyInterestInput();
        }
      });
      interestInput?.addEventListener('blur', applyInterestInput);

      document.getElementById('interest4-minus')?.addEventListener('click', () => changeInterest(-INTEREST_STEP));
      document.getElementById('interest4-plus')?.addEventListener('click', () => changeInterest(INTEREST_STEP));

      const interest4ValueBtn = document.getElementById('interest4-value') as HTMLButtonElement | null;
      const interest4Editor = document.getElementById('interest4-editor') as HTMLElement | null;
      const interest4Input = document.getElementById('interest4-input') as HTMLInputElement | null;
      const interest4Apply = document.getElementById('interest4-apply') as HTMLButtonElement | null;

      interest4ValueBtn?.addEventListener('click', () => {
        if (!interest4Editor || !interest4Input) return;
        interest4Editor.hidden = !interest4Editor.hidden;
        if (!interest4Editor.hidden) {
          interest4Input.value = String(interestRate).replace('.', ',');
          interest4Input.focus();
          interest4Input.select();
        }
      });

      function applyInterest4Input(): void {
        const parsed = parseFloat((interest4Input?.value ?? '').replace(',', '.'));
        if (Number.isFinite(parsed)) {
          commitInterest(parsed);
        }
        syncInterestUI();
        if (interest4Editor) interest4Editor.hidden = true;
      }

      interest4Apply?.addEventListener('click', applyInterest4Input);
      interest4Input?.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          applyInterest4Input();
        }
      });
      interest4Input?.addEventListener('blur', applyInterest4Input);

      saveSimulationBtn?.addEventListener('click', saveSimulation);

      document.addEventListener('click', (event) => {
        const el = (event.target as Element | null)?.closest('[data-start-wizard]') as HTMLElement | null;
        if (el) {
          event.preventDefault();
          lastTrigger = el;
          openSheet();
          if (document.getElementById('income') && readNumber('income') <= 0) {
            goTo(1);
          }
          return;
        }
      });

      document.addEventListener('click', (event) => {
        const el = (event.target as Element | null)?.closest('[data-campaign-cta]') as HTMLElement | null;
        if (!el) return;
        const cta = el.getAttribute('data-campaign-cta') ?? 'default';
        const context = {
          ...campaignContext(),
          template: config.template,
          cta,
          result_status: lastStatus,
        };
        trackEvent('campaign_cta_click', context);
        if (cta === 'kpr_check') {
          markCalculatorStart();
        }
        if (cta === 'whatsapp') {
          if (waCta && waCta.getAttribute('aria-disabled') === 'true') {
            event.preventDefault();
            return;
          }
          trackEvent('whatsapp_click', {
            ...campaignContext(),
            template: config.template,
            result_status: lastStatus,
          });
        }
      });

      // restore autosaved wizard state
      const stored = readStored();
      if (stored) {
        setRupiahInput('income', stored.income);
        setRupiahInput('existing', stored.existing);
        setRupiahInput('expenses', stored.expenses);
        applyDetailGroup('existing-detail', stored.installmentDetails);
        applyDetailGroup('expenses-detail', stored.expenseDetails);
        interestRate = stored.interest;
        fundingMode =
          stored.fundingMode === 'syariah' && modeRates.syariah == null
            ? 'promo'
            : stored.fundingMode || 'promo';
        if (fundingMode === 'syariah' && modeRates.syariah == null) {
          modeRates.promo = stored.interest;
        } else {
          modeRates[fundingMode] = stored.interest;
        }
        hasDp = stored.hasDp;
        dpValue = stored.dp;
        selectedTenor = config.tenorPresetsMonths.includes(stored.tenorMonths)
          ? stored.tenorMonths
          : config.defaultTenorMonths;
        syncInterestUI();
        syncDpUI();
        syncTenorUI();
        syncFundingUI();
        if (stored.income > 0) {
          openSheet();
          if (stored.step === 2) {
            renderResult();
            currentStep = 2;
            render(true);
          } else {
            currentStep = 1;
            render(true);
          }
          showRestoreNotice();
        }
      }

      if (step1Next) step1Next.disabled = readNumber('income') <= 0;
      syncFundingUI();
      renderSavedList();
      initWaScrollGate();
      updateWaCtaState();
      render(false);
    </script>
  </body>
</html>