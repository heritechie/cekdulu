---
title: "Cek Kemampuan Cicilan - CekDulu"
---

<! class="bg-background text-foreground">
  <html lang="id">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <meta name="description" content="Kalkulator kemampuan cicilan - Cek sebelum mengambil cicilan KPR, mobil, atau motor" />
      <title>Cek Kemampuan Cicilan | CekDulu</title>
      <link rel="canonical" href="https://cekdulu.id/kalkulator-kemampuan-cicilan" />
      <meta property="og:title" content="CekDulu - Kalkulator Kemampuan Cicilan" />
      <meta property="og:description" content="Cek kemampuan finansial sebelum mengambil cicilan" />
      <meta property="og:type" content="website" />
      <meta property="og:url" content="https://cekdulu.id/kalkulator-kemampuan-cicilan" />
      <meta property="og:locale" content="id_ID" />
      <meta name="twitter:card" content="summary" />
      <meta name="twitter:title" content="CekDulu" />
    </head>
    <body class="font-sans antialiased min-h-screen bg-background text-foreground">
      <div class="max-w-2xl w-full px-4 sm:px-6 lg:px-8 py-12">

        <div class="scale-icon mb-8">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto w-16 h-16 text-primary">
            <path d="M12 2v4M12 20v-4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M12 2v4m0 16v-4M4.93 19.07l2.83-2.83M15.72 15.72l2.83-2.83" />
          </svg>
        </div>

        <!-- Ad slot: between calculator and explanation -->
        <include src="/src/components/ad-slot-between.astro" />

        <form id="calculatorForm" class="space-y-6">
          <input
            type="number"
            id="monthlyIncome"
            min="0"
            step="100000"
            required
            aria-label="Penghasilan per bulan"
            class="w-full px-4 py-3 rounded-xl text-lg focus-outline outline-none focus:ring-2 focus:ring-primary"
          />
          <label class="text-sm font-medium text-foreground-200 mb-2 block">Penghasilan per bulan</label>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <input
                type="number"
                id="existingInstallments"
                min="0"
                step="100000"
                aria-label="Cicilan yang sudah berjalan"
                class="w-full px-4 py-3 rounded-xl text-lg focus-outline outline-none focus:ring-2 focus:ring-primary"
              />
              <label class="text-sm font-medium text-foreground-200 mb-2 block">Cicilan yang sudah berjalan</label>
            </div>
            <div>
              <input
                type="number"
                id="newInstallment"
                min="0"
                step="100000"
                aria-label="Cicilan baru"
                class="w-full px-4 py-3 rounded-xl text-lg focus-outline outline-none focus:ring-2 focus:ring-primary"
              />
              <label class="text-sm font-medium text-foreground-200 mb-2 block">Cicilan baru</label>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <input
                type="number"
                id="foodHousing"
                min="0"
                step="10000"
                aria-label="Makan & kebutuhan rumah"
                class="w-full px-4 py-3 rounded-xl text-lg focus-outline outline-none focus:ring-2 focus:ring-primary"
              />
              <label class="text-sm font-medium text-foreground-200 mb-2 block">Makan & kebutuhan rumah</label>
            </div>
            <div>
              <input
                type="number"
                id="rent"
                min="0"
                step="10000"
                aria-label="Tempat tinggal"
                class="w-full px-4 py-3 rounded-xl text-lg focus-outline outline-none focus:ring-2 focus:ring-primary"
              />
              <label class="text-sm font-medium text-foreground-200 mb-2 block">Tempat tinggal</label>
            </div>
            <div>
              <input
                type="number"
                id="electricity"
                min="0"
                step="10000"
                aria-label="Listrik & internet"
                class="w-full px-4 py-3 rounded-xl text-lg focus-outline outline-none focus:ring-2 focus:ring-primary"
              />
              <label class="text-sm font-medium text-foreground-200 mb-2 block">Listrik & internet</label>
            </div>
            <div>
              <input
                type="number"
                id="transport"
                min="0"
                step="10000"
                aria-label="Transportasi"
                class="w-full px-4 py-3 rounded-xl text-lg focus-outline outline-none focus:ring-2 focus:ring-primary"
              />
              <label class="text-sm font-medium text-foreground-200 mb-2 block">Transportasi</label>
            </div>
          </div>

          <div>
            <input
              type="number"
              id="education"
              min="0"
              step="10000"
              aria-label="Pendidikan"
              class="w-full px-4 py-3 rounded-xl text-lg focus-outline outline-none focus:ring-2 focus:ring-primary"
            />
            <label class="text-sm font-medium text-foreground-200 mb-2 block">Pendidikan</label>
          </div>

          <div>
            <input
              type="number"
              id="otherExpenses"
              min="0"
              step="10000"
              aria-label="Lainnya"
              class="w-full px-4 py-3 rounded-xl text-lg focus-outline outline-none focus:ring-2 focus:ring-primary"
            />
            <label class="text-sm font-medium text-foreground-200 mb-2 block">Lainnya</label>
          </div>

          <button
            type="submit"
            class="w-full px-6 py-3 bg-primary text-primary-foreground rounded-full font-medium text-lg hover:opacity-90 transition-opacity shadow-sm"
          >
            Hitung Kemampuan Cicilan
          </button>
        </form>

        <div id="result" class="mt-12">
          <div class="scale-icon mb-6">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--scale-stroke, currentColor)" stroke-width="1.5" class="mx-auto w-20 h-20">
              <path d="M12 2v4M12 20v-4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M12 2v4m0 16v-4M4.93 19.07l2.83-2.83M15.72 15.72l2.83-2.83" />
            </svg>
          </div>
          <div id="result-content" class="text-center">
            <!-- Result content will be injected by JS -->
          </div>
          <div class="mt-4 flex flex-col sm:flex-row gap-2 justify-center">
            <button
              id="shareResultBtn"
              class="inline-flex items-center gap-2 px-4 py-2 bg-secondary text-secondary-foreground rounded-full font-medium hover:opacity-90 transition-opacity"
              disabled>
              Bagikan Hasil
            </button>
          </div>
        </div>

<!-- Ad slot: after result -->
        <include src="/src/components/ad-slot-after-result.astro" />
      </div>

      <script>
        function formatRupiah(amount) {
          return new Intl.NumberFormat('id-ID', {
            style: 'currency',
            currency: 'IDR',
            minimumFractionDigits: 0,
            maximumFractionDigits: 0,
          }).format(amount);
        }

        function formatPercentage(value) {
          return `${value.toFixed(1)}%`;
        }

        document.getElementById('calculatorForm')?.addEventListener('submit', (e) => {
          e.preventDefault();

          const income = parseFloat(document.getElementById('monthlyIncome')?.value || '0') || 0;
          const existing = parseFloat(document.getElementById('existingInstallments')?.value || '0') || 0;
          const newInst = parseFloat(document.getElementById('newInstallment')?.value || '0') || 0;

          const foodHousing = parseFloat(document.getElementById('foodHousing')?.value || '0') || 0;
          const rent = parseFloat(document.getElementById('rent')?.value || '0') || 0;
          const electricity = parseFloat(document.getElementById('electricity')?.value || '0') || 0;
          const transport = parseFloat(document.getElementById('transport')?.value || '0') || 0;
          const education = parseFloat(document.getElementById('education')?.value || '0') || 0;
          const otherExpenses = parseFloat(document.getElementById('otherExpenses')?.value || '0') || 0;
          const totalExpenses = foodHousing + rent + electricity + transport + education + otherExpenses;

          const totalMonthlyDebt = existing + newInst;
          const debtRatio = income > 0 ? (totalMonthlyDebt / income) * 100 : 0;
          const remainingAfterDebt = income - totalMonthlyDebt;
          const remainingAfterDebtAndExpenses = income - totalMonthlyDebt - totalExpenses;

          let financialStatus, financialStatusClass;
          if (debtRatio <= 30 && remainingAfterDebtAndExpenses >= 0) {
            financialStatus = 'Kondisi keuangan sehat';
            financialStatusClass = 'healthy';
          } else if (debtRatio <= 45 && remainingAfterDebtAndExpenses >= 0) {
            financialStatus = 'Penggunaan cicilan perlu diperhatikan';
            financialStatusClass = 'warning';
          } else {
            financialStatus = 'Beban cicilan terlalu besar';
            financialStatusClass = 'critical';
          }

          const resultDiv = document.getElementById('result-content');
          const resultTitle = document.getElementById('result');
          const shareBtn = document.getElementById('shareResultBtn');

          resultDiv.innerHTML = `
            <p class="text-lg mb-2">
              Penghasilanmu <span class="font-medium">${formatRupiah(income)}</span> per bulan.
            </p>
            <p class="text-lg mb-2">
              Total cicilan menjadi <span class="font-medium">${formatRupiah(totalMonthlyDebt)}</span> per bulan.
            </p>
            <p class="text-lg mb-2">
              Setelah cicilan dan pengeluaran, <span class="font-medium">${formatRupiah(remainingAfterDebtAndExpenses)}</span> tersisa.
            </p>
            <p class="text-lg mb-2">
              Beban cicilan: <span class="font-medium">${formatPercentage(debtRatio)}</span> dari penghasilan.
            </p>
            <p class="text-sm text-foreground-muted mt-3">
              ${financialStatus}
            </p>
          `;

          resultTitle.classList.remove('hidden');
          resultTitle.classList.add('block');

          // Update balance scale color based on condition
          const scaleSvg = document.querySelector('#result .scale-icon svg');
          if (scaleSvg) {
            if (debtRatio <= 30 && remainingAfterDebtAndExpenses >= 0) {
              scaleSvg.style.setProperty('--scale-stroke', '#10b981');
            } else if (debtRatio <= 45 && remainingAfterDebtAndExpenses >= 0) {
              scaleSvg.style.setProperty('--scale-stroke', '#f59e0b');
            } else {
              scaleSvg.style.setProperty('--scale-stroke', '#ef4444');
            }
          }

          // Enable share button
          shareBtn.disabled = false;

          // Focus result area
          resultTitle.scrollIntoView({ behavior: 'smooth' });
        });

        // Share functionality
        document.getElementById('shareResultBtn')?.addEventListener('click', async (e) => {
          const income = parseFloat(document.getElementById('monthlyIncome')?.value || '0') || 0;
          const existing = parseFloat(document.getElementById('existingInstallments')?.value || '0') || 0;
          const newInst = parseFloat(document.getElementById('newInstallment')?.value || '0') || 0;
          const foodHousing = parseFloat(document.getElementById('foodHousing')?.value || '0') || 0;
          const rent = parseFloat(document.getElementById('rent')?.value || '0') || 0;
          const electricity = parseFloat(document.getElementById('electricity')?.value || '0') || 0;
          const transport = parseFloat(document.getElementById('transport')?.value || '0') || 0;
          const education = parseFloat(document.getElementById('education')?.value || '0') || 0;
          const otherExpenses = parseFloat(document.getElementById('otherExpenses')?.value || '0') || 0;
          const totalExpenses = foodHousing + rent + electricity + transport + education + otherExpenses;

          const totalMonthlyDebt = existing + newInst;
          const debtRatio = income > 0 ? (totalMonthlyDebt / income) * 100 : 0;
          const remainingAfterDebtAndExpenses = income - totalMonthlyDebt - totalExpenses;

          const shareData = {
            title: 'CekDulu - Hasil Kalkulator Kemampuan Cicilan',
            text: `Penghasilan ${formatRupiah(income)}, total cicilan ${formatRupiah(totalMonthlyDebt)}, sisa ${formatRupiah(remainingAfterDebtAndExpenses)}, DBR ${formatPercentage(debtRatio)}%`,
          };

          // Try Web Share API
          if (navigator.share) {
            try {
              await navigator.share(shareData);
              // Share successful, could add analytics here
            } catch (err) {
              // User dismissed the share dialog
              // Fall back to copy link
              fallbackShare();
            }
          } else {
            fallbackShare();
          }

          function fallbackShare() {
            // Copy result link/text to clipboard
            const tempInput = document.createElement('input');
            tempInput.value = `${formatRupiah(income)} | ${formatRupiah(totalMonthlyDebt)} | ${formatPercentage(debtRatio)}`;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);

            // Show feedback
            shareBtn.textContent = 'Disalin!';
            shareBtn.classList.add('bg-success', 'text-success-foreground');
            setTimeout(() => {
              shareBtn.textContent = 'Bagikan Hasil';
              shareBtn.classList.remove('bg-success', 'text-success-foreground');
            }, 2000);
          }
        });
      </script>
    </body>
  </html>