---
import Layout from '../layouts/Layout.astro';
import NumberField from '../components/number-field.astro';
import MoneyRow from '../components/money-row.astro';
import { Button } from '@/components/ui/button';
import { Card, CardContent } from '@/components/ui/card';
import { Separator } from '@/components/ui/separator';
import { Info, ArrowLeft, ArrowRight, Share2, RefreshCw, Download } from 'lucide-astro';
import AdSlotBetween from '../components/ad-slot-between.astro';
import AdSlotAfterResult from '../components/ad-slot-after-result.astro';

const canonical = new URL('kalkulator-kemampuan-cicilan', Astro.site).href;
---
<Layout
  title="Kalkulator Kemampuan Cicilan — Cek Sebelum Nyicil | CekDulu"
  description="Cek kemampuan cicilan berdasarkan penghasilan, cicilan yang sudah ada, cicilan baru, dan pengeluaran bulanan. Hitung sisa uang dan rasio cicilan sebelum mengambil utang."
  canonical={canonical}
  ogTitle="Kalkulator Kemampuan Cicilan — Cek Sebelum Nyicil | CekDulu"
  ogDescription="Cek kemampuan cicilan berdasarkan penghasilan, cicilan yang sudah ada, cicilan baru, dan pengeluaran bulanan."
  ogUrl={canonical}
>
  <div class="mx-auto w-full max-w-2xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">

    <button
      id="wizard-back"
      type="button"
      data-back
      hidden
      class="-ml-2 inline-flex items-center gap-1.5 rounded-md px-2 py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50"
    >
      <ArrowLeft class="h-4 w-4" aria-hidden="true" />
      Kembali
    </button>

    <div class="mt-2 w-full text-center">
      <h1 class="text-balance text-2xl font-bold tracking-tight sm:text-3xl">Cek Kemampuan Cicilan</h1>
      <p id="wizard-type" class="mt-1 text-sm text-muted-foreground">Kredit yang dicek: Lainnya</p>

      <p id="step-label" class="mt-5 text-sm font-medium text-muted-foreground" aria-live="polite">1 dari 5</p>
      <div
        id="wizard-progress"
        role="progressbar"
        aria-valuemin="1"
        aria-valuemax="5"
        aria-valuenow="1"
        aria-label="Progres kalkulator"
        class="mx-auto mt-2 flex w-full max-w-[240px] items-center gap-1.5"
      >
        <span data-seg="1" class="h-1.5 flex-1 rounded-full bg-primary"></span>
        <span data-seg="2" class="h-1.5 flex-1 rounded-full bg-border"></span>
        <span data-seg="3" class="h-1.5 flex-1 rounded-full bg-border"></span>
        <span data-seg="4" class="h-1.5 flex-1 rounded-full bg-border"></span>
        <span data-seg="5" class="h-1.5 flex-1 rounded-full bg-border"></span>
      </div>

      <div id="wizard-illustration-wrap" class="mt-4 flex items-center justify-center">
        <img
          id="wizard-illustration"
          src="/images/wizard/income.webp"
          alt="Ilustrasi penghasilan bersih"
          width="130"
          height="110"
          decoding="async"
          class="h-[110px] w-[130px] object-contain sm:h-[120px] sm:w-[150px]"
        />
      </div>
    </div>

    <form id="wizardForm" class="mt-5" novalidate>
      <Card
        id="step-1"
        tabIndex={-1}
        className="animate-in fade-in duration-150 rounded-2xl border border-border py-0 shadow-sm ring-0 focus:outline-none"
      >
        <CardContent className="p-5 sm:p-6">
          <h2 class="text-lg font-semibold text-foreground sm:text-xl">Penghasilan Bersih</h2>
          <p class="mt-1 text-sm text-muted-foreground">Masukkan total penghasilan bersih yang kamu terima setiap bulan.</p>
          <div class="mt-4">
            <NumberField id="monthlyIncome" label="Penghasilan per bulan" required />
            <p id="error-monthlyIncome" class="mt-2 hidden text-sm font-medium text-[#ef4444]" aria-live="polite"></p>
            <div class="mt-3 flex items-start gap-2.5 rounded-xl bg-muted/50 p-3 text-sm text-muted-foreground">
              <Info class="mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true" />
              <span>Masukkan jumlah setelah dipotong pajak dan potongan lainnya.</span>
            </div>
          </div>
          <div class="mt-6 flex justify-end">
            <Button type="submit" className="h-auto w-full gap-2 rounded-full px-6 py-3.5 text-base font-semibold sm:w-auto sm:px-8">
              Lanjutkan
              <ArrowRight class="h-4 w-4" aria-hidden="true" />
            </Button>
          </div>
        </CardContent>
      </Card>

      <Card
        id="step-2"
        tabIndex={-1}
        className="animate-in fade-in duration-150 hidden rounded-2xl border border-border py-0 shadow-sm ring-0 focus:outline-none"
      >
        <CardContent className="p-5 sm:p-6">
          <h2 class="text-lg font-semibold text-foreground sm:text-xl">Cicilan yang Sudah Ada</h2>
          <p class="mt-1 text-sm text-muted-foreground">Masukkan semua cicilan atau kewajiban bulanan yang sudah kamu miliki.</p>
          <div class="mt-4 space-y-3">
            <MoneyRow id="kpr" label="KPR / Rumah" icon="home" />
            <MoneyRow id="mobil" label="Mobil" icon="car" />
            <MoneyRow id="motor" label="Motor" icon="bike" />
            <MoneyRow id="kartuKredit" label="Kartu Kredit" icon="card" />
            <MoneyRow id="pinjamanLain" label="Pinjaman Lain" icon="briefcase" />
          </div>
          <div class="mt-4 rounded-xl bg-muted/50 p-3 text-center">
            <p class="text-sm text-muted-foreground">Total cicilan saat ini</p>
            <p id="step2-total" class="mt-0.5 text-lg font-bold text-foreground">Rp 0</p>
            <p class="text-xs text-muted-foreground">per bulan</p>
          </div>
          <div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end sm:gap-3">
            <Button type="button" data-back variant="outline" className="h-auto w-full gap-2 rounded-full px-6 py-3.5 text-base sm:w-auto">
              <ArrowLeft class="h-4 w-4" aria-hidden="true" />
              Kembali
            </Button>
            <Button type="submit" className="h-auto w-full gap-2 rounded-full px-6 py-3.5 text-base font-semibold sm:w-auto sm:px-8">
              Lanjutkan
              <ArrowRight class="h-4 w-4" aria-hidden="true" />
            </Button>
          </div>
        </CardContent>
      </Card>

      <Card
        id="step-3"
        tabIndex={-1}
        className="animate-in fade-in duration-150 hidden rounded-2xl border border-border py-0 shadow-sm ring-0 focus:outline-none"
      >
        <CardContent className="p-5 sm:p-6">
          <h2 class="text-lg font-semibold text-foreground sm:text-xl">Rencana Cicilan Baru</h2>
          <p class="mt-1 text-sm text-muted-foreground">Masukkan estimasi cicilan bulanan dari pinjaman yang ingin kamu ambil (opsional).</p>
          <div class="mt-4">
            <NumberField id="newInstallment" label="Cicilan baru per bulan" />
            <div class="mt-3 flex items-start gap-2.5 rounded-xl bg-muted/50 p-3 text-sm text-muted-foreground">
              <Info class="mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true" />
              <span>Gunakan angka perkiraan cicilan per bulan dari pihak bank atau leasing. Kosongkan jika hanya ingin cek ruang cicilan.</span>
            </div>
          </div>
          <div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end sm:gap-3">
            <Button type="button" data-back variant="outline" className="h-auto w-full gap-2 rounded-full px-6 py-3.5 text-base sm:w-auto">
              <ArrowLeft class="h-4 w-4" aria-hidden="true" />
              Kembali
            </Button>
            <Button type="submit" className="h-auto w-full gap-2 rounded-full px-6 py-3.5 text-base font-semibold sm:w-auto sm:px-8">
              Lanjutkan
              <ArrowRight class="h-4 w-4" aria-hidden="true" />
            </Button>
          </div>
        </CardContent>
      </Card>

      <Card
        id="step-4"
        tabIndex={-1}
        className="animate-in fade-in duration-150 hidden rounded-2xl border border-border py-0 shadow-sm ring-0 focus:outline-none"
      >
        <CardContent className="p-5 sm:p-6">
          <h2 class="text-lg font-semibold text-foreground sm:text-xl">Pengeluaran Bulanan</h2>
          <p class="mt-1 text-sm text-muted-foreground">Breakdown pengeluaran rutin kamu setiap bulan (opsional).</p>
          <div class="mt-4 space-y-3">
            <MoneyRow id="foodHousing" label="Makan & kebutuhan rumah" icon="utensils" />
            <MoneyRow id="rent" label="Sewa / tempat tinggal" icon="building" />
            <MoneyRow id="electricity" label="Listrik & internet" icon="zap" />
            <MoneyRow id="transport" label="Transportasi" icon="bus" />
            <MoneyRow id="education" label="Pendidikan" icon="graduation" />
            <MoneyRow id="health" label="Kesehatan" icon="heart" />
            <MoneyRow id="entertainment" label="Hiburan & gaya hidup" icon="clapperboard" />
            <MoneyRow id="otherExpenses" label="Lainnya" icon="ellipsis" />
          </div>
          <div class="mt-4 rounded-xl bg-muted/50 p-3 text-center">
            <p class="text-sm text-muted-foreground">Total pengeluaran</p>
            <p id="step4-total" class="mt-0.5 text-lg font-bold text-foreground">Rp 0</p>
            <p class="text-xs text-muted-foreground">per bulan</p>
          </div>
          <div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end sm:gap-3">
            <Button type="button" data-back variant="outline" className="h-auto w-full gap-2 rounded-full px-6 py-3.5 text-base sm:w-auto">
              <ArrowLeft class="h-4 w-4" aria-hidden="true" />
              Kembali
            </Button>
            <Button type="submit" className="h-auto w-full gap-2 rounded-full px-6 py-3.5 text-base font-semibold sm:w-auto sm:px-8">
              Lihat Hasil
              <ArrowRight class="h-4 w-4" aria-hidden="true" />
            </Button>
          </div>
        </CardContent>
      </Card>

      <Card
        id="step-5"
        tabIndex={-1}
        className="animate-in fade-in duration-150 hidden rounded-2xl border border-border py-0 shadow-sm ring-0 focus:outline-none"
      >
        <CardContent className="p-5 sm:p-6" aria-live="polite">
          <h2 class="text-center text-lg font-semibold text-foreground sm:text-xl">Hasil Cek</h2>

          <div class="mt-4 flex justify-center">
            <img
              src="/images/wizard/result.webp"
              alt="Ilustrasi timbangan keuangan"
              width="730"
              height="512"
              loading="lazy"
              decoding="async"
              class="h-auto w-full max-w-[170px] sm:max-w-[190px]"
            />
          </div>

          <p
            id="result-headline"
            role="status"
            class="mt-4 text-balance px-2 text-center text-xl font-bold tracking-tight text-foreground sm:text-2xl"
          ></p>

          <div class="mt-4 rounded-2xl border border-border bg-muted/40 p-4 text-center">
            <p class="text-sm text-muted-foreground">Sisa uang setelah semua beban</p>
            <p id="result-sisa" class="mt-1 text-3xl font-bold text-foreground">Rp 0</p>
            <p class="text-xs text-muted-foreground">per bulan</p>
            <span id="result-badge" class="mt-3 inline-block rounded-full px-3 py-1 text-sm font-medium"></span>
          </div>

          <div class="mt-4 rounded-xl bg-muted/50 p-4 text-sm">
            <p class="font-semibold text-foreground">Apa artinya?</p>
            <p id="result-note" class="mt-1.5 leading-relaxed text-muted-foreground"></p>
          </div>

          <Separator className="my-5" />

          <div class="mx-auto max-w-xs space-y-1.5 text-sm">
            <div class="flex justify-between">
              <span class="text-muted-foreground">Penghasilan bersih</span>
              <span id="result-income" class="font-medium"></span>
            </div>
            <div class="flex justify-between">
              <span class="text-muted-foreground">Cicilan lama</span>
              <span id="result-existing" class="font-medium"></span>
            </div>
            <div class="flex justify-between">
              <span class="text-muted-foreground">Cicilan baru</span>
              <span id="result-new" class="font-medium"></span>
            </div>
            <div class="flex justify-between">
              <span class="text-muted-foreground">Pengeluaran bulanan</span>
              <span id="result-expense" class="font-medium"></span>
            </div>
            <div class="flex justify-between border-t border-border/60 pt-1.5">
              <span class="font-medium text-foreground">Total beban</span>
              <span id="result-total-beban" class="font-medium"></span>
            </div>
            <div class="flex justify-between">
              <span class="text-muted-foreground">Sisa uang</span>
              <span id="result-breakdown-sisa" class="font-medium"></span>
            </div>
          </div>

          <div class="mx-auto mt-4 max-w-xs rounded-xl bg-muted/50 p-3 text-xs leading-relaxed text-muted-foreground">
            <div class="flex items-baseline justify-between gap-2">
              <span>Rasio Cicilan (DBR)</span>
              <span id="result-dbr" class="text-sm font-semibold text-foreground"></span>
            </div>
            <p class="mt-1.5">
              <a href="/apa-itu-dbr" class="inline-flex items-center gap-1 font-medium text-primary underline underline-offset-4 hover:text-primary/80">
                Apa itu DBR?
                <ArrowRight class="h-3 w-3" aria-hidden="true" />
              </a>
            </p>
            <p class="mt-1.5">
              Ini hanya indikator ilustrasi dan bisa berbeda tergantung kebijakan bank atau lembaga pembiayaan.
            </p>
          </div>

          <Separator className="my-5" />

          <div id="scenario-panel" class="hidden">
            <p class="font-medium text-foreground">Coba skenario cicilan baru</p>
            <p class="mt-0.5 text-sm text-muted-foreground">Geser nilai di bawah untuk melihat dampaknya pada sisa uang.</p>
            <div class="mt-4">
              <div class="flex items-center justify-between gap-3 mb-2">
                <label for="scenarioSlider" class="text-sm font-medium text-muted-foreground">Cicilan baru per bulan</label>
                <span id="scenarioValue" class="text-lg font-bold text-foreground">Rp 0</span>
              </div>
              <div class="relative">
                <input
                  id="scenarioSlider"
                  type="range"
                  min="0"
                  max="10000000"
                  step="100000"
                  value="0"
                  class="w-full h-2 bg-muted rounded-lg appearance-none cursor-pointer accent-primary"
                  aria-label="Cicilan baru per bulan"
                />
                <div class="flex justify-between text-xs text-muted-foreground mt-1">
                  <span>Rp 0</span>
                  <span id="scenarioMaxLabel">Rp 10.000.000</span>
                </div>
              </div>
              <div class="mt-3 rounded-xl bg-muted/50 p-3 text-center">
                <p class="text-xs text-muted-foreground">Sisa uang jika cicilan ini</p>
                <p id="scenario-sisa" class="mt-0.5 text-xl font-bold text-foreground">Rp 0</p>
              </div>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <Button id="skenarioBtn" type="button" className="h-auto w-full gap-2 rounded-full px-6 py-3 text-base font-semibold">
              <RefreshCw class="h-4 w-4" aria-hidden="true" />
              Coba Skenario Lain
            </Button>
            <Button id="saveResultBtn" type="button" variant="outline" className="h-auto w-full gap-2 rounded-full px-6 py-3 text-base" disabled>
              <Download class="h-4 w-4" aria-hidden="true" />
              Simpan Hasil
            </Button>
            <Button id="shareResultBtn" type="button" className="h-auto w-full gap-2 rounded-full px-6 py-3 text-base font-semibold" disabled>
              <Share2 class="h-4 w-4" aria-hidden="true" />
              Bagikan Hasil
            </Button>
            <Button id="ubahDataBtn" type="button" variant="secondary" className="h-auto w-full rounded-full px-6 py-3 text-base">
              Ubah Data
            </Button>
          </div>
        </CardContent>
      </Card>
    </form>

    <!-- Ad slots: around the utility, outside the input flow -->
    <AdSlotBetween />
    <AdSlotAfterResult />
  </div>

  <script>
    import { calculateFinancialBalance } from '../lib/calculator/engine';
    import { generateShareFile } from '../lib/share-image';
    import { renderCalculatorShareImagePng } from '../lib/calculator-share-image';
    import {
      trackEvent,
      incomeRange,
      installmentRange,
      expenseRange,
      debtRatioRange,
      remainingIncomeRange,
      resultCategory,
    } from '../lib/analytics';

    function formatRupiah(amount: number) {
      return new Intl.NumberFormat('id-ID', {
        style: 'currency',
        currency: 'IDR',
        minimumFractionDigits: 0,
        maximumFractionDigits: 0,
      }).format(amount);
    }

    function formatPercentage(value: number) {
      return `${value.toFixed(1)}%`;
    }

    function formatMoneyInput(input: HTMLInputElement) {
      const caretDigits = input.value.slice(0, input.selectionStart ?? 0).replace(/\D/g, '').length;
      const raw = input.value.replace(/\D/g, '').replace(/^0+(?=\d)/, '');
      const formatted = raw ? raw.replace(/\B(?=(\d{3})+(?!\d))/g, '.') : '';
      input.dataset.value = raw;
      input.value = formatted;
      let digits = 0;
      let pos = 0;
      while (pos < formatted.length && digits < caretDigits) {
        if (/\d/.test(formatted[pos])) digits += 1;
        pos += 1;
      }
      input.setSelectionRange(pos, pos);
    }

    function readNumber(id: string): number {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (!el) return 0;
      const raw = el.dataset.value ?? el.value.replace(/\D/g, '');
      return raw ? parseFloat(raw) || 0 : 0;
    }

    function setRupiahInput(id: string, value: number): void {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (!el || value < 0) return;
      const v = value.toLocaleString('id-ID');
      el.value = v;
      el.dataset.value = String(Math.round(value));
    }

    // ---- wizard state ----
    const totalSteps = 5;
    let currentStep = 1;
    let started = false;
    let completed = false;

    const stepLabel = document.getElementById('step-label') as HTMLElement;
    const progressRoot = document.getElementById('wizard-progress') as HTMLElement | null;
    const wizardBack = document.getElementById('wizard-back') as HTMLElement | null;
    const wizardIllustration = document.getElementById('wizard-illustration') as HTMLImageElement | null;
    const stepEls: Record<number, HTMLElement> = {
      1: document.getElementById('step-1') as HTMLElement,
      2: document.getElementById('step-2') as HTMLElement,
      3: document.getElementById('step-3') as HTMLElement,
      4: document.getElementById('step-4') as HTMLElement,
      5: document.getElementById('step-5') as HTMLElement,
    };

    const illustrations: Record<number, { src: string; alt: string }> = {
      1: { src: '/images/wizard/income.webp', alt: 'Ilustrasi penghasilan bersih' },
      2: { src: '/images/wizard/existing-installments.webp', alt: 'Ilustrasi cicilan yang sudah ada' },
      3: { src: '/images/wizard/new-installment.webp', alt: 'Ilustrasi rencana cicilan baru' },
      4: { src: '/images/wizard/monthly-expenses.webp', alt: 'Ilustrasi pengeluaran bulanan' },
      5: { src: '/images/wizard/result.webp', alt: 'Ilustrasi hasil perhitungan' },
    };

    // financing type from homepage selection (?type=...)
    const typeSlug = new URLSearchParams(window.location.search).get('type') ?? 'lainnya';
    const typeLabels: Record<string, string> = {
      rumah: 'Rumah / KPR',
      kendaraan: 'Kendaraan',
      elektronik: 'Elektronik',
      lainnya: 'Lainnya',
    };
    const typeLabel = typeLabels[typeSlug] ?? 'Lainnya';
    const typeEl = document.getElementById('wizard-type');
    if (typeEl) typeEl.textContent = `Kredit yang dicek: ${typeLabel}`;

    // type-aware copy helpers
    const typeNoun: Record<string, string> = {
      rumah: 'rumah',
      kendaraan: 'kendaraan',
      elektronik: 'elektronik',
      lainnya: 'cicilan',
    };
    const typeNounCapitalized: Record<string, string> = {
      rumah: 'Rumah',
      kendaraan: 'Kendaraan',
      elektronik: 'Elektronik',
      lainnya: 'Cicilan',
    };

    // ---- currency formatting on all wizard inputs ----
    document.querySelectorAll<HTMLInputElement>('#wizardForm input').forEach((input) => {
      input.addEventListener('input', () => formatMoneyInput(input));
      input.addEventListener('keydown', (e) => {
        if (e.ctrlKey || e.metaKey || e.altKey) return;
        if (e.key.length > 1 || /[0-9]/.test(e.key)) return;
        e.preventDefault();
      });
    });

    const incomeError = document.getElementById('error-monthlyIncome') as HTMLElement;
    document.getElementById('monthlyIncome')?.addEventListener('input', () => {
      incomeError.classList.add('hidden');
      incomeError.textContent = '';
    });

    // ---- live totals for step 2 and step 4 ----
    const step2Ids = ['kpr', 'mobil', 'motor', 'kartuKredit', 'pinjamanLain'];
    const step4Ids = ['foodHousing', 'rent', 'electricity', 'transport', 'education', 'health', 'entertainment', 'otherExpenses'];

    function updateTotal(ids: string[], elId: string) {
      const total = ids.reduce((sum, id) => sum + readNumber(id), 0);
      const el = document.getElementById(elId);
      if (el) el.textContent = formatRupiah(total);
    }

    step2Ids.forEach((id) => {
      document.getElementById(id)?.addEventListener('input', () => updateTotal(step2Ids, 'step2-total'));
    });
    step4Ids.forEach((id) => {
      document.getElementById(id)?.addEventListener('input', () => updateTotal(step4Ids, 'step4-total'));
    });

    function showError(id: string, message: string) {
      const el = document.getElementById(id) as HTMLElement | null;
      if (!el) return;
      el.textContent = message;
      el.classList.remove('hidden');
    }

    function clearError(id: string) {
      const el = document.getElementById(id) as HTMLElement | null;
      if (!el) return;
      el.textContent = '';
      el.classList.add('hidden');
    }

    function validateStep(step: number): boolean {
      if (step === 1) {
        const income = readNumber('monthlyIncome');
        if (income <= 0) {
          showError('error-monthlyIncome', 'Masukkan penghasilan bulananmu terlebih dahulu.');
          document.getElementById('monthlyIncome')?.focus();
          return false;
        }
      }
      clearError('error-monthlyIncome');
      return true;
    }

    function updateProgress() {
      stepLabel.textContent = `${currentStep} dari ${totalSteps}`;
      progressRoot?.setAttribute('aria-valuenow', String(currentStep));
      progressRoot?.querySelectorAll<HTMLElement>('[data-seg]').forEach((seg) => {
        const n = Number(seg.dataset.seg);
        const active = n <= currentStep;
        seg.classList.toggle('bg-primary', active);
        seg.classList.toggle('bg-border', !active);
      });
    }

    function updateIllustration() {
      const wrap = document.getElementById('wizard-illustration-wrap');
      if (currentStep === 5) {
        wrap?.classList.add('hidden');
        return;
      }
      wrap?.classList.remove('hidden');
      const ill = illustrations[currentStep];
      if (wizardIllustration && ill) {
        wizardIllustration.setAttribute('src', ill.src);
        wizardIllustration.setAttribute('alt', ill.alt);
      }
    }

    function render(focusStep: boolean) {
      for (let s = 1; s <= totalSteps; s++) {
        stepEls[s].classList.toggle('hidden', s !== currentStep);
      }
      updateProgress();
      updateIllustration();
      if (wizardBack) {
        wizardBack.hidden = currentStep === 1;
      }
      if (focusStep) {
        stepEls[currentStep].focus();
      }
    }

    function goTo(step: number) {
      currentStep = Math.min(totalSteps, Math.max(1, step));
      render(true);
      window.scrollTo({ top: 0, behavior: 'smooth' });
      history.pushState({ s: currentStep }, '');
    }

    function compute() {
      const income = readNumber('monthlyIncome');
      const existing = step2Ids.reduce((sum, id) => sum + readNumber(id), 0);
      const newInst = readNumber('newInstallment');
      const hasNewInstInput = (document.getElementById('newInstallment') as HTMLInputElement | null)?.dataset.value !== undefined &&
        (document.getElementById('newInstallment') as HTMLInputElement | null)?.dataset.value !== '';
      const totalExpenses = step4Ids.reduce((sum, id) => sum + readNumber(id), 0);
      const hasExpensesInput = step4Ids.some(id => {
        const el = document.getElementById(id) as HTMLInputElement | null;
        return el && el.dataset.value !== undefined && el.dataset.value !== '';
      });
      const result = calculateFinancialBalance(income, existing, newInst, totalExpenses);
      return { result, income, totalExpenses, hasNewInstInput, hasExpensesInput };
    }

    // ---- form submit: validate current step, then advance or show result ----
    document.getElementById('wizardForm')?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!validateStep(currentStep)) return;
      const stepName = ['income', 'existing_debt', 'new_installment', 'expenses'][currentStep - 1];
      if (currentStep === 1 && !started) {
        trackEvent('calculator_start', { calculator_type: 'affordability', financing_type: typeSlug });
        started = true;
      }
      trackEvent('calculator_step_complete', { calculator_type: 'affordability', step: stepName, financing_type: typeSlug });
      if (currentStep < 4) {
        goTo(currentStep + 1);
      } else {
        fillResult();
        goTo(5);
        trackCompleteAndView();
      }
    });

    function trackCompleteAndView() {
      if (completed) return;
      completed = true;
      const { result } = compute();
      const existing = step2Ids.reduce((sum, id) => sum + readNumber(id), 0);
      const newInst = readNumber('newInstallment');
      const expenses = step4Ids.reduce((sum, id) => sum + readNumber(id), 0);
      const completeParams = {
        calculator_type: 'affordability',
        income_range: incomeRange(readNumber('monthlyIncome')),
        existing_debt_range: installmentRange(existing),
        new_installment_range: installmentRange(newInst),
        monthly_expense_range: expenseRange(expenses),
        debt_ratio_range: debtRatioRange(result.debtRatio),
        remaining_income_range: remainingIncomeRange(result.remainingAfterDebtAndExpenses),
        result_category: resultCategory(result),
        financing_type: typeSlug,
      };
      trackEvent('calculator_complete', completeParams);
      trackEvent('result_view', {
        calculator_type: 'affordability',
        result_category: resultCategory(result),
        financing_type: typeSlug,
      });
    }

    document.querySelectorAll<HTMLButtonElement>('[data-back]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (currentStep > 1) goTo(currentStep - 1);
      });
    });

    function resultHeadline(result: {
      remainingAfterDebtAndExpenses: number;
      financialStatusClass: string;
    }, hasNewInst: boolean, hasNewInstInput: boolean): string {
      const noun = typeNoun[typeSlug] ?? 'cicilan';
      const hasIncome = readNumber('monthlyIncome') > 0;
      
      if (!hasIncome) {
        return 'Masukkan penghasilan untuk melihat hasil';
      }
      
      if (result.remainingAfterDebtAndExpenses < 0) {
        return `Beban ${noun} melebihi penghasilan bulanan`;
      }
      
      if (!hasNewInstInput) {
        // No new installment input - show capacity
        const capacity = result.remainingAfterDebtAndExpenses;
        if (capacity >= 0) {
          return `Masih ada ruang untuk cicilan ${noun} sekitar ${formatRupiah(capacity)}/bulan`;
        }
        return `Ruang cicilan ${noun} sudah habis`;
      }
      
      // Has new installment input - evaluate the plan
      if (result.financialStatusClass === 'healthy') {
        return hasNewInst
          ? `Rencana cicilan ${noun} ini masih cukup seimbang`
          : `Ruang cicilan ${noun} masih cukup lega`;
      }
      if (result.financialStatusClass === 'warning') {
        return hasNewInst
          ? `Rencana cicilan ${noun} ini mulai terasa berat`
          : `Ruang cicilan ${noun} mulai sempit`;
      }
      return hasNewInst
        ? `Beban cicilan ${noun} terlalu besar`
        : `Ruang cicilan ${noun} terlalu sempit`;
    }

    function resultBadgeText(status: string, remaining: number): string {
      if (remaining < 0) return 'Berisiko';
      if (status === 'healthy') return 'Sehat';
      if (status === 'warning') return 'Perlu Perhatian';
      return 'Berisiko';
    }

function fillResult() {
      const { result, income, totalExpenses, hasNewInstInput, hasExpensesInput } = compute();
      const existing = step2Ids.reduce((sum, id) => sum + readNumber(id), 0);
      const newInst = readNumber('newInstallment');
      const hasNewInst = newInst > 0;

      const badgeClass =
        result.remainingAfterDebtAndExpenses < 0
          ? 'bg-[#ef4444]/10 text-[#ef4444]'
          : result.financialStatusClass === 'healthy'
          ? 'bg-[#10b981]/10 text-[#10b981]'
          : 'bg-[#f59e0b]/10 text-[#f59e0b]';
      const sisaClass = result.remainingAfterDebtAndExpenses < 0 ? 'text-[#ef4444]' : 'text-[#10b981]';

      const headlineEl = document.getElementById('result-headline');
      const sisaEl = document.getElementById('result-sisa');
      const badgeEl = document.getElementById('result-badge');
      const noteEl = document.getElementById('result-note');
      const dbrEl = document.getElementById('result-dbr');
      const incomeEl = document.getElementById('result-income');
      const existingEl = document.getElementById('result-existing');
      const newEl = document.getElementById('result-new');
      const expenseEl = document.getElementById('result-expense');
      const totalBebanEl = document.getElementById('result-total-beban');
      const breakdownSisaEl = document.getElementById('result-breakdown-sisa');
      const shareBtn = document.getElementById('shareResultBtn') as HTMLButtonElement | null;
      const saveBtn = document.getElementById('saveResultBtn') as HTMLButtonElement | null;
      if (
        !headlineEl || !sisaEl || !badgeEl || !noteEl || !dbrEl || !incomeEl ||
        !existingEl || !newEl || !expenseEl || !totalBebanEl || !breakdownSisaEl || !shareBtn || !saveBtn
      ) {
        return;
      }

      headlineEl.textContent = resultHeadline(result, hasNewInst, hasNewInstInput);
      sisaEl.textContent = formatRupiah(result.remainingAfterDebtAndExpenses);
      sisaEl.className = `mt-1 text-3xl font-bold ${sisaClass}`;
      badgeEl.textContent = resultBadgeText(result.financialStatusClass, result.remainingAfterDebtAndExpenses);
      badgeEl.className = `mt-3 inline-block rounded-full px-3 py-1 text-sm font-semibold ${badgeClass}`;
      noteEl.textContent = resultNote(result, hasNewInst, hasNewInstInput, hasExpensesInput);
      dbrEl.textContent = formatPercentage(result.debtRatio);
      incomeEl.textContent = formatRupiah(income);
      existingEl.textContent = formatRupiah(existing);
      newEl.textContent = hasNewInstInput ? formatRupiah(newInst) : '—';
      expenseEl.textContent = hasExpensesInput ? formatRupiah(totalExpenses) : '—';
      totalBebanEl.textContent = formatRupiah(result.totalMonthlyDebt + totalExpenses);
      breakdownSisaEl.textContent = formatRupiah(result.remainingAfterDebtAndExpenses);

      shareBtn.disabled = false;
      saveBtn.disabled = false;
      initScenario(newInst, existing, totalExpenses, hasExpensesInput);
    }

    function resultNote(result: {
      remainingAfterDebtAndExpenses: number;
      financialStatusClass: string;
    }, hasNewInst: boolean, hasNewInstInput: boolean, hasExpensesInput: boolean): string {
      const noun = typeNoun[typeSlug] ?? 'cicilan';
      const nounCap = typeNounCapitalized[typeSlug] ?? 'Cicilan';
      
      // Awareness message for missing daily expenses
      const expensesAwareness = !hasExpensesInput
        ? '\n\nPerhitungan ini belum memasukkan kebutuhan sehari-hari. Isi pengeluaran bulananmu untuk mendapatkan gambaran yang lebih realistis.'
        : '';

      const hasIncome = readNumber('monthlyIncome') > 0;
      if (!hasIncome) {
        return 'Masukkan penghasilan bulananmu untuk melihat hasil perhitungan.';
      }

      // NEGATIVE: expenses exceed income
      if (result.remainingAfterDebtAndExpenses < 0) {
        const base = `Total ${noun} dan pengeluaran bulananmu lebih besar dari penghasilan. Sebelum menambah beban baru, sebaiknya kondisi ini ditinjau kembali.`;
        return base + expensesAwareness;
      }

      // NO NEW INSTALLMENT INPUT - show capacity
      if (!hasNewInstInput) {
        const capacity = result.remainingAfterDebtAndExpenses;
        if (capacity > 0) {
          const base = `Masih ada ruang untuk cicilan ${noun} sekitar ${formatRupiah(capacity)}/bulan berdasarkan sisa uangmu setelah beban bulanan.`;
          return base + expensesAwareness;
        }
        return `Ruang cicilan ${noun} sudah habis.${expensesAwareness}`;
      }

      // HAS NEW INSTALLMENT INPUT - evaluate the plan
      if (result.financialStatusClass === 'healthy') {
        const base = hasNewInst
          ? `Rencana cicilan ${noun} ini masih cukup seimbang. Masih ada sisa uang untuk kebutuhan lain.`
          : `Ruang cicilan ${noun} masih cukup lega untuk rencana baru.`;
        return base + expensesAwareness;
      }
      if (result.financialStatusClass === 'warning') {
        const base = hasNewInst
          ? `Rencana cicilan ${noun} ini mulai terasa berat. Masih ada sisa uang tapi ruang untuk kebutuhan lain semakin terbatas.`
          : `Ruang cicilan ${noun} mulai sempit. Pertimbangkan dengan hati-hati sebelum menambah beban.`;
        return base + expensesAwareness;
      }
      // critical
      const base = hasNewInst
        ? `Beban cicilan ${noun} terlalu besar dan menyisakan sedikit ruang untuk kebutuhan lain. Perlu dipertimbangkan kembali.`
        : `Ruang cicilan ${noun} terlalu sempit untuk rencana baru.`;
      return base + expensesAwareness;
    }

    function initScenario(baseNew: number, existing: number, expenses: number, hasExpensesInput: boolean) {
      const slider = document.getElementById('scenarioSlider') as HTMLInputElement | null;
      const valueEl = document.getElementById('scenarioValue') as HTMLElement | null;
      const maxLabelEl = document.getElementById('scenarioMaxLabel') as HTMLElement | null;
      const sisaEl = document.getElementById('scenario-sisa') as HTMLElement | null;
      if (!slider || !valueEl || !maxLabelEl || !sisaEl) return;

      // Set max: allow testing up to 10M or at least 1M above the original installment
      // so user can test higher values than what they originally entered
      const income = readNumber('monthlyIncome');
      const initialVal = baseNew > 0 ? baseNew : 0;
      const incomeBasedMax = Math.min(Math.max(1_000_000, Math.floor(income * 0.5)), 10_000_000);
      const minMaxForTesting = initialVal > 0 ? Math.ceil((initialVal + 1_000_000) / 100_000) * 100_000 : 10_000_000;
      const maxValRounded = Math.ceil(Math.max(incomeBasedMax, minMaxForTesting) / 100_000) * 100_000;
      slider.max = String(maxValRounded);
      slider.step = '100000';

      // Set initial value: use baseNew if provided, else 0
      slider.value = String(initialVal);

      // Update max label
      maxLabelEl.textContent = formatRupiah(maxValRounded);

      // Update value display
      const updateValueDisplay = (val: number) => {
        if (valueEl) valueEl.textContent = formatRupiah(val) + ' / bulan';
      };
      updateValueDisplay(initialVal);

      // Recalculate and update scenario sisa
      const recalc = (val: number) => {
        const imgIncome = readNumber('monthlyIncome');
        const r = calculateFinancialBalance(imgIncome, existing, val, expenses);
        if (sisaEl) {
          sisaEl.textContent = formatRupiah(r.remainingAfterDebtAndExpenses);
          sisaEl.className = `mt-0.5 text-xl font-bold ${r.remainingAfterDebtAndExpenses < 0 ? 'text-[#ef4444]' : 'text-[#10b981]'}`;
        }
        // Also update the main result display in real-time
        updateMainResult(imgIncome, existing, val, expenses, hasExpensesInput);
      };

      // Slider input handler
      if (!(slider.dataset.hooked === '1')) {
        slider.dataset.hooked = '1';
        slider.addEventListener('input', () => {
          const val = Number(slider.value);
          updateValueDisplay(val);
          recalc(val);
        });
        slider.addEventListener('change', () => {
          // Optional: could trigger analytics here if needed
        });
      }

      // Initial calculation
      recalc(initialVal);
    }

    function updateMainResult(income: number, existing: number, newInst: number, expenses: number, hasExpensesInput: boolean) {
      const result = calculateFinancialBalance(income, existing, newInst, expenses);
      const hasNewInstInput = newInst > 0;

      const badgeClass =
        result.remainingAfterDebtAndExpenses < 0
          ? 'bg-[#ef4444]/10 text-[#ef4444]'
          : result.financialStatusClass === 'healthy'
          ? 'bg-[#10b981]/10 text-[#10b981]'
          : 'bg-[#f59e0b]/10 text-[#f59e0b]';
      const sisaClass = result.remainingAfterDebtAndExpenses < 0 ? 'text-[#ef4444]' : 'text-[#10b981]';

      const headlineEl = document.getElementById('result-headline');
      const sisaEl = document.getElementById('result-sisa');
      const badgeEl = document.getElementById('result-badge');
      const noteEl = document.getElementById('result-note');
      const dbrEl = document.getElementById('result-dbr');
      const incomeEl = document.getElementById('result-income');
      const existingEl = document.getElementById('result-existing');
      const newEl = document.getElementById('result-new');
      const expenseEl = document.getElementById('result-expense');
      const totalBebanEl = document.getElementById('result-total-beban');
      const breakdownSisaEl = document.getElementById('result-breakdown-sisa');

      if (
        !headlineEl || !sisaEl || !badgeEl || !noteEl || !dbrEl || !incomeEl ||
        !existingEl || !newEl || !expenseEl || !totalBebanEl || !breakdownSisaEl
      ) {
        return;
      }

      headlineEl.textContent = resultHeadline(result, newInst > 0, newInst > 0);
      sisaEl.textContent = formatRupiah(result.remainingAfterDebtAndExpenses);
      sisaEl.className = `mt-1 text-3xl font-bold ${sisaClass}`;
      badgeEl.textContent = resultBadgeText(result.financialStatusClass, result.remainingAfterDebtAndExpenses);
      badgeEl.className = `mt-3 inline-block rounded-full px-3 py-1 text-sm font-semibold ${badgeClass}`;
      noteEl.textContent = resultNote(result, newInst > 0, newInst > 0, hasExpensesInput);
      dbrEl.textContent = formatPercentage(result.debtRatio);
      incomeEl.textContent = formatRupiah(income);
      existingEl.textContent = formatRupiah(existing);
      newEl.textContent = formatRupiah(newInst);
      expenseEl.textContent = formatRupiah(expenses);
      totalBebanEl.textContent = formatRupiah(result.totalMonthlyDebt + expenses);
      breakdownSisaEl.textContent = formatRupiah(result.remainingAfterDebtAndExpenses);
    }

    document.getElementById('ubahDataBtn')?.addEventListener('click', () => {
      completed = false;
      goTo(1);
    });
    document.getElementById('skenarioBtn')?.addEventListener('click', () => {
      const panel = document.getElementById('scenario-panel');
      if (!panel) return;
      const open = panel.classList.toggle('hidden');
      document.getElementById('skenarioBtn')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      if (open === false) {
        document.getElementById('scenarioInput')?.focus();
      }
    });

    // ---- browser back restores the wizard step without losing values ----
    window.addEventListener('popstate', (e) => {
      const st = e.state as { s?: number } | null;
      currentStep = st && typeof st.s === 'number' ? Math.min(totalSteps, Math.max(1, st.s)) : 1;
      render(false);
    });

    // ---- save & share (two distinct intents) ----
    function shareStatusLabel(result: { remainingAfterDebtAndExpenses: number; financialStatusClass: string }): string {
      if (result.remainingAfterDebtAndExpenses < 0) return 'Berisiko';
      if (result.financialStatusClass === 'healthy') return 'Sehat';
      if (result.financialStatusClass === 'warning') return 'Perlu Perhatian';
      return 'Berisiko';
    }

    function shareStatusKey(result: { remainingAfterDebtAndExpenses: number; financialStatusClass: string }): 'healthy' | 'warning' | 'critical' | 'negative' {
      if (result.remainingAfterDebtAndExpenses < 0) return 'negative';
      return result.financialStatusClass as 'healthy' | 'warning' | 'critical';
    }

    let busyAction: 'save' | 'share' | null = null;

    function releaseButton(id: string) {
      const btn = document.getElementById(id) as HTMLButtonElement | null;
      if (btn) btn.disabled = false;
      busyAction = null;
    }

    /** Simpan Hasil: personal result card -> direct PNG download (no social template). */
    async function saveResult() {
      const btn = document.getElementById('saveResultBtn') as HTMLButtonElement | null;
      if (!btn || busyAction) return;
      busyAction = 'save';
      const { result, income, totalExpenses, hasNewInstInput } = compute();
      const hasNewInst = readNumber('newInstallment') > 0;
      const originalBtn = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Membuat gambar…';

      const fileResult = await generateShareFile({
        headline: resultHeadline(result, hasNewInst, hasNewInstInput),
        statusLabel: shareStatusLabel(result),
        status: shareStatusKey(result),
        remaining: result.remainingAfterDebtAndExpenses,
        income,
        totalDebt: result.totalMonthlyDebt,
        totalExpenses,
      });

      btn.innerHTML = originalBtn;
      releaseButton('saveResultBtn');
      if (!fileResult.file || !fileResult.url) return;

      const a = document.createElement('a');
      a.href = fileResult.url;
      a.download = 'cekdulu-hasil.png';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      const savedUrl = fileResult.url;
      setTimeout(() => URL.revokeObjectURL(savedUrl), 10_000);

      trackEvent('result_save', {
        calculator_type: 'affordability',
        result_category: resultCategory(result),
        financing_type: typeSlug,
      });
    }

    function downloadFile(file: File) {
      const url = URL.createObjectURL(file);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'cekdulu-hasil-kemampuan-cicilan.png';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 10_000);
    }

    /** Bagikan Hasil: social/invitation image -> image-only Web Share -> download. */
    async function shareResult() {
      const btn = document.getElementById('shareResultBtn') as HTMLButtonElement | null;
      if (!btn || busyAction) return;
      busyAction = 'share';
      const { result } = compute();
      const originalBtn = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Membuat gambar…';

      let file: File | null = null;
      try {
        file = await renderCalculatorShareImagePng({
          remaining: result.remainingAfterDebtAndExpenses,
          financialStatusClass: result.financialStatusClass,
        });
      } catch {
        file = null;
      }

      btn.innerHTML = originalBtn;
      releaseButton('shareResultBtn');
      if (!file) return;

      let method: 'web_share' | 'download' = 'download';
      const shareData = { files: [file] };
      if (typeof navigator.share === 'function' && navigator.canShare?.(shareData)) {
        try {
          await navigator.share(shareData);
          method = 'web_share';
        } catch (err) {
          if ((err as Error).name === 'AbortError') return; // user cancelled: no event
          method = 'download';
        }
      }
      if (method === 'download') downloadFile(file);

      trackEvent('result_share', {
        calculator_type: 'affordability',
        share_method: method,
        result_category: resultCategory(result),
        financing_type: typeSlug,
      });
    }

    document.getElementById('saveResultBtn')?.addEventListener('click', saveResult);
    document.getElementById('shareResultBtn')?.addEventListener('click', shareResult);

    // ---- restore calculation from shared URL (client-side only) ----
    const hadSharedParams = (function restoreFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const hasCalc = ['i', 'x', 'n', 'e'].some((k) => params.has(k));
      if (!hasCalc) return false;

      setRupiahInput('monthlyIncome', Number(params.get('i')) || 0);
      step2Ids.forEach((id) => setRupiahInput(id, 0));
      step4Ids.forEach((id) => setRupiahInput(id, 0));
      setRupiahInput('newInstallment', Number(params.get('n')) || 0);
      const x = Number(params.get('x')) || 0;
      const e = Number(params.get('e')) || 0;
      if (x > 0) setRupiahInput('kpr', x);
      if (e > 0) setRupiahInput('foodHousing', e);
      updateTotal(step2Ids, 'step2-total');
      updateTotal(step4Ids, 'step4-total');
      fillResult();
      goTo(5);
      return true;
    })();

    // ---- initial render ----
    if (!hadSharedParams) render(false);
  </script>
</Layout>
