---
import Layout from '../layouts/Layout.astro';
import AdSlotHeader from '../components/ad-slot-header.astro';
import { Card, CardContent } from '@/components/ui/card';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { Menu, House, Car, Bike, Smartphone, MoreHorizontal, ArrowRight } from 'lucide-astro';
---
<Layout
  title="CekDulu - Kalkulator Kemampuan Cicilan"
  description="Cek sebelum mengambil cicilan KPR, mobil, atau motor. Masukkan penghasilan, cicilan existing, cicilan baru, dan pengeluaran bulanan untuk melihat sisa uangmu."
  canonical="https://cekdulu.id/kalkulator-kemampuan-cicilan"
  ogDescription="Cek kemampuan finansial sebelum mengambil cicilan"
>
  <header class="border-b border-border/60">
    <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
      <a href="/" class="inline-flex items-center gap-2 font-bold tracking-tight text-foreground">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary text-primary-foreground">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
            <path d="M12 3v18" />
            <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2" />
            <path d="M5 7v3c0 1.5 1.5 2 3.5 2S12 11.5 12 10V7" />
            <path d="M19 7v3c0 1.5-1.5 2-3.5 2S12 11.5 12 10V7" />
            <path d="M8 16h8" />
          </svg>
        </span>
        CekDulu.co.id
      </a>
      <div class="relative md:hidden">
        <button
          id="menuBtn"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label="Menu"
          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border text-foreground transition-colors hover:bg-muted"
        >
          <Menu class="h-5 w-5" aria-hidden="true" />
        </button>
        <div id="menuPopover" class="absolute right-0 top-full z-10 mt-2 hidden w-44 rounded-xl border border-border bg-card p-1 shadow-sm">
          <a href="/" class="block rounded-lg px-3 py-2 text-sm text-foreground transition-colors hover:bg-muted">Beranda</a>
          <a href="/calculator" class="block rounded-lg px-3 py-2 text-sm text-foreground transition-colors hover:bg-muted">Kalkulator Cicilan</a>
        </div>
      </div>
    </div>
  </header>

  <main>
    <section id="hero" class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-8 pt-10 pb-4 sm:gap-10 sm:pt-14 sm:pb-6 lg:grid-cols-2 lg:gap-14 lg:pt-20 lg:pb-8">
        <div id="hero-text" class="order-1 text-center lg:order-none lg:col-start-1 lg:row-start-1 lg:text-left">
          <h1 class="text-balance text-4xl font-extrabold leading-[1.1] tracking-tight sm:text-5xl lg:text-6xl">
            Sebelum nyicil,<br class="hidden sm:inline" /> <span class="text-primary">cek dulu.</span>
          </h1>
          <p class="mx-auto mt-4 max-w-xl text-lg text-muted-foreground sm:text-xl lg:mx-0">
            Lihat apakah rencana cicilanmu masih seimbang dengan kondisi keuanganmu.
          </p>
        </div>

        <div
          id="hero-illustration"
          class="order-2 flex items-center justify-center lg:order-none lg:col-start-2 lg:row-start-1 lg:row-span-2"
        >
          <div class="w-full max-w-[340px] sm:max-w-sm lg:max-w-md">
            <img
              src="/images/illustrations/hero-balance-v1.png"
              alt="Timbangan keuangan CekDulu"
              width="1536"
              height="1024"
              class="h-auto w-full"
            />
          </div>
        </div>

        <div
          id="hero-cta"
          class="order-3 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:order-none lg:col-start-1 lg:row-start-2 lg:justify-start"
        >
          <a
            href="/calculator"
            class={cn(buttonVariants({ variant: 'default' }), 'h-auto w-full rounded-full px-8 py-4 text-base sm:w-auto sm:text-lg')}
          >
            Cek Kemampuan Cicilan
            <ArrowRight class="h-5 w-5" aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>

    <!-- Ad slot: after hero -->
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
      <AdSlotHeader />
    </div>

    <!-- Quick start -->
    <section id="quick-start" class="mx-auto w-full max-w-6xl px-4 pt-6 pb-12 sm:px-6 sm:pt-10 sm:pb-16 lg:px-8">
      <div class="mx-auto max-w-2xl">
        <Card className="rounded-2xl border border-border py-0 shadow-sm ring-0">
          <CardContent className="p-5 sm:p-6">
            <p class="text-center text-base font-semibold text-foreground">Mulai hitung kemampuan cicilanmu</p>
            <p class="mt-1 text-center text-sm text-muted-foreground">Mau hitung cicilan apa?</p>

            <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
              <button
                type="button"
                data-fin-type="rumah"
                aria-pressed="true"
                class="flex flex-col items-center gap-2 rounded-xl border px-4 py-5 text-sm font-medium transition-colors border-primary bg-primary/5 text-primary"
              >
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-card shadow-sm">
                  <House class="h-6 w-6" aria-hidden="true" />
                </span>
                Rumah / KPR
              </button>
              <button
                type="button"
                data-fin-type="kendaraan"
                aria-pressed="false"
                class="flex flex-col items-center gap-2 rounded-xl border px-4 py-5 text-sm font-medium transition-colors border-border bg-card text-foreground"
              >
                <span class="inline-flex h-12 w-12 items-center justify-center gap-1 rounded-full bg-muted">
                  <Car class="h-5 w-5" aria-hidden="true" />
                  <Bike class="h-5 w-5" aria-hidden="true" />
                </span>
                Kendaraan
              </button>
              <button
                type="button"
                data-fin-type="elektronik"
                aria-pressed="false"
                class="flex flex-col items-center gap-2 rounded-xl border px-4 py-5 text-sm font-medium transition-colors border-border bg-card text-foreground"
              >
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-muted">
                  <Smartphone class="h-6 w-6" aria-hidden="true" />
                </span>
                Elektronik
              </button>
              <button
                type="button"
                data-fin-type="lainnya"
                aria-pressed="false"
                class="flex flex-col items-center gap-2 rounded-xl border px-4 py-5 text-sm font-medium transition-colors border-border bg-card text-foreground"
              >
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-muted">
                  <MoreHorizontal class="h-6 w-6" aria-hidden="true" />
                </span>
                Lainnya
              </button>
            </div>

            <div class="mt-5">
              <a
                id="startBtn"
                href="/calculator?type=rumah"
                class={cn(buttonVariants({ variant: 'default' }), 'h-auto w-full gap-2 rounded-full px-6 py-3.5 text-base')}
              >
                Mulai Sekarang
                <ArrowRight class="h-5 w-5" aria-hidden="true" />
              </a>
            </div>
          </CardContent>
        </Card>
      </div>
    </section>
  </main>

  <script>
    const menuBtn = document.getElementById('menuBtn');
    const menuPopover = document.getElementById('menuPopover');

    menuBtn?.addEventListener('click', () => {
      const willOpen = menuPopover?.classList.toggle('hidden') ?? true;
      menuBtn.setAttribute('aria-expanded', String(!willOpen));
    });

    document.addEventListener('click', (e) => {
      if (!e.target || !(e.target as Element).closest('#menuBtn, #menuPopover')) {
        menuPopover?.classList.add('hidden');
        menuBtn?.setAttribute('aria-expanded', 'false');
      }
    });

    const finBtns = document.querySelectorAll<HTMLButtonElement>('[data-fin-type]');
    const startBtn = document.getElementById('startBtn');

    function selectType(type: string) {
      finBtns.forEach((b) => {
        const active = b.dataset.finType === type;
        b.classList.toggle('border-primary', active);
        b.classList.toggle('bg-primary/5', active);
        b.classList.toggle('text-primary', active);
        b.classList.toggle('border-border', !active);
        b.classList.toggle('bg-card', !active);
        b.classList.toggle('text-foreground', !active);
        b.setAttribute('aria-pressed', String(active));
      });
      if (startBtn) startBtn.setAttribute('href', `/calculator?type=${type}`);
    }

    finBtns.forEach((b) => {
      b.addEventListener('click', () => {
        if (b.dataset.finType) selectType(b.dataset.finType);
      });
    });
  </script>
</Layout>
