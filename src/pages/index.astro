---
import Layout from '../layouts/Layout.astro';
import AdSlotHeader from '../components/ad-slot-header.astro';
import { Card, CardContent } from '@/components/ui/card';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { ArrowRight } from 'lucide-astro';

const homepage = new URL('/', Astro.site).href;
---
<Layout
  title="CekDulu - Kalkulator Kemampuan Cicilan"
  description="Cek sebelum mengambil cicilan KPR, mobil, atau motor. Masukkan penghasilan, cicilan existing, cicilan baru, dan pengeluaran bulanan untuk melihat sisa uangmu."
  canonical={homepage}
  ogUrl={homepage}
  ogDescription="Cek kemampuan finansial sebelum mengambil cicilan"
>
  <main>
    <section id="hero" class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-8 pt-10 pb-4 sm:gap-10 sm:pt-14 sm:pb-6 lg:grid-cols-2 lg:gap-14 lg:pt-20 lg:pb-8">
        <div id="hero-text" class="order-1 text-center lg:order-none lg:col-start-1 lg:row-start-1 lg:text-left">
          <h1 class="text-balance text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl lg:text-6xl">
            Sebelum nyicil,<br class="hidden sm:inline" /> <span class="text-primary">cek dulu.</span>
          </h1>
          <p class="mx-auto mt-4 max-w-xl text-lg text-muted-foreground sm:text-xl lg:mx-0">
            Lihat apakah rencana cicilanmu masih seimbang dengan kondisi keuanganmu.
          </p>
        </div>

        <div
          id="hero-illustration"
          class="order-2 flex items-center justify-center lg:order-none lg:col-start-2 lg:row-start-1 lg:row-span-2"
        >
          <div class="w-full max-w-[340px] sm:max-w-sm lg:max-w-md">
            <img
              src="/images/illustrations/hero-balance-v1.png"
              alt="Timbangan keuangan CekDulu"
              width="1536"
              height="1024"
              class="h-auto w-full"
            />
          </div>
        </div>

        <div
          id="hero-cta"
          class="order-3 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:order-none lg:col-start-1 lg:row-start-2 lg:justify-start"
        >
          <a
            href="/kalkulator-kemampuan-cicilan"
            class={cn(buttonVariants({ variant: 'default' }), 'h-auto w-full gap-2 rounded-full px-8 py-3.5 text-base font-semibold sm:w-auto')}
          >
            Cek Kemampuan Cicilan
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>

    <!-- Ad slot: after hero -->
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
      <AdSlotHeader />
    </div>

    <!-- Quick start -->
    <section id="quick-start" class="mx-auto w-full max-w-6xl px-4 pt-6 pb-12 sm:px-6 sm:pt-10 sm:pb-16 lg:px-8">
      <div class="mx-auto max-w-2xl">
        <Card className="rounded-2xl border border-border py-0 shadow-sm ring-0">
          <CardContent className="p-5 sm:p-6">
            <p class="text-center text-base font-semibold text-foreground">Mulai hitung kemampuan cicilanmu</p>
            <p class="mt-1 text-center text-sm text-muted-foreground">Mau hitung cicilan apa?</p>

            <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
              <button
                type="button"
                data-fin-type="rumah"
                aria-pressed="true"
                class="flex flex-col items-center gap-2 rounded-xl border px-4 py-4 text-sm font-medium transition-colors border-primary bg-primary/5 text-primary"
              >
                <img
                  src="/images/illustrations/home.png"
                  alt=""
                  width="512"
                  height="512"
                  loading="lazy"
                  class="h-20 w-20 object-contain sm:h-24 sm:w-24"
                />
                Rumah / KPR
              </button>
              <button
                type="button"
                data-fin-type="kendaraan"
                aria-pressed="false"
                class="flex flex-col items-center gap-2 rounded-xl border px-4 py-4 text-sm font-medium transition-colors border-border bg-card text-foreground"
              >
                <img
                  src="/images/illustrations/vehicle.png"
                  alt=""
                  width="512"
                  height="512"
                  loading="lazy"
                  class="h-20 w-20 object-contain sm:h-24 sm:w-24"
                />
                Kendaraan
              </button>
              <button
                type="button"
                data-fin-type="elektronik"
                aria-pressed="false"
                class="flex flex-col items-center gap-2 rounded-xl border px-4 py-4 text-sm font-medium transition-colors border-border bg-card text-foreground"
              >
                <img
                  src="/images/illustrations/electronics.png"
                  alt=""
                  width="512"
                  height="512"
                  loading="lazy"
                  class="h-20 w-20 object-contain sm:h-24 sm:w-24"
                />
                Elektronik
              </button>
              <button
                type="button"
                data-fin-type="lainnya"
                aria-pressed="false"
                class="flex flex-col items-center gap-2 rounded-xl border px-4 py-4 text-sm font-medium transition-colors border-border bg-card text-foreground"
              >
                <img
                  src="/images/illustrations/other.png"
                  alt=""
                  width="512"
                  height="512"
                  loading="lazy"
                  class="h-20 w-20 object-contain sm:h-24 sm:w-24"
                />
                Lainnya
              </button>
            </div>

            <div class="mt-5">
              <a
                id="startBtn"
                href="/kalkulator-kemampuan-cicilan?type=rumah"
                class={cn(buttonVariants({ variant: 'default' }), 'h-auto w-full gap-2 rounded-full px-6 py-3.5 text-base font-semibold')}
              >
                Mulai Sekarang
                <ArrowRight class="h-4 w-4" aria-hidden="true" />
              </a>
            </div>
          </CardContent>
        </Card>
      </div>
    </section>

    <!-- Pelajari sebelum nyicil: educational discovery -->
    <section id="belajar" class="mx-auto w-full max-w-6xl px-4 pt-2 pb-12 sm:px-6 sm:pb-16 lg:px-8">
      <div class="mx-auto max-w-2xl">
        <h2 class="text-center text-lg font-semibold text-foreground">Pelajari Sebelum Nyicil</h2>
        <p class="mt-1 text-center text-sm text-muted-foreground">Kenali istilah dan cara sederhana menilai kemampuan cicilanmu.</p>
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          <a
            href="/apa-itu-dbr"
            class="group flex items-center justify-between gap-3 rounded-xl border border-border bg-card p-5 transition-colors hover:bg-muted/50"
          >
            <span class="text-sm font-semibold text-foreground">Apa Itu DBR?</span>
            <ArrowRight class="h-4 w-4 shrink-0 text-primary transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
          </a>
          <a
            href="/berapa-persen-gaji-ideal-untuk-cicilan"
            class="group flex items-center justify-between gap-3 rounded-xl border border-border bg-card p-5 transition-colors hover:bg-muted/50"
          >
            <span class="text-sm font-semibold text-foreground">Berapa Persen Gaji yang Ideal untuk Cicilan?</span>
            <ArrowRight class="h-4 w-4 shrink-0 text-primary transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
          </a>
          <a
            id="challenge-resume"
            href="/challenges/30-hari-tanpa-paylater"
            class="group flex items-center justify-between gap-3 rounded-xl border border-border bg-card p-5 transition-colors hover:bg-muted/50"
          >
            <span class="flex min-w-0 items-center gap-3">
              <img
                id="challenge-resume-icon"
                src="/cekdulu-30-hari-tanpa-paylater-assets/illustrations/30-days-no-paylater.png"
                alt=""
                aria-hidden="true"
                width="280"
                height="233"
                class="h-7 w-auto shrink-0"
                hidden
              />
              <span class="flex min-w-0 flex-col">
                <span class="text-sm font-semibold text-foreground">30 Hari Tanpa PayLater</span>
                <span id="challenge-resume-sub" class="mt-0.5 text-xs font-medium text-primary" hidden></span>
                <span
                  id="challenge-resume-progress"
                  class="mt-1.5 flex h-1 w-24 max-w-full overflow-hidden rounded-full bg-muted"
                  role="progressbar"
                  aria-valuemin="1"
                  aria-valuemax="30"
                  aria-valuenow="1"
                  hidden
                >
                  <span id="challenge-resume-fill" class="block h-full rounded-full bg-primary" style="width: 0%"></span>
                </span>
              </span>
            </span>
            <span class="flex shrink-0 items-center gap-1.5">
              <span id="challenge-resume-cta" class="text-xs font-semibold text-primary" hidden></span>
              <ArrowRight class="h-4 w-4 shrink-0 text-primary transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
            </span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <script>
    const finBtns = document.querySelectorAll<HTMLButtonElement>('[data-fin-type]');
    const startBtn = document.getElementById('startBtn');

    function selectType(type: string) {
      finBtns.forEach((b) => {
        const active = b.dataset.finType === type;
        b.classList.toggle('border-primary', active);
        b.classList.toggle('bg-primary/5', active);
        b.classList.toggle('text-primary', active);
        b.classList.toggle('border-border', !active);
        b.classList.toggle('bg-card', !active);
        b.classList.toggle('text-foreground', !active);
        b.setAttribute('aria-pressed', String(active));
      });
      if (startBtn) startBtn.setAttribute('href', `/kalkulator-kemampuan-cicilan?type=${type}`);
    }

    finBtns.forEach((b) => {
      b.addEventListener('click', () => {
        if (b.dataset.finType) selectType(b.dataset.finType);
      });
    });
  </script>

  <script>
    import { CHALLENGE_DAYS, dayForDate, isChallengeComplete, readChallengeStorage } from '../lib/paylater-challenge';

    const challengeState = readChallengeStorage();
    if (challengeState) {
      const icon = document.getElementById('challenge-resume-icon') as HTMLImageElement | null;
      const sub = document.getElementById('challenge-resume-sub');
      const progress = document.getElementById('challenge-resume-progress');
      const fill = document.getElementById('challenge-resume-fill');
      const cta = document.getElementById('challenge-resume-cta');

      const done = challengeState.completed || isChallengeComplete(challengeState);
      if (done) {
        if (icon) {
          icon.src = '/cekdulu-30-hari-tanpa-paylater-assets/illustrations/trophy.png';
          icon.hidden = false;
        }
        if (sub) {
          sub.textContent = 'Challenge selesai';
          sub.hidden = false;
        }
        if (cta) {
          cta.textContent = 'Lihat Hasil';
          cta.hidden = false;
        }
      } else {
        const day = dayForDate(challengeState.startDate);
        if (icon) icon.hidden = false;
        if (sub) {
          sub.textContent = `Hari ke-${day} dari ${CHALLENGE_DAYS}`;
          sub.hidden = false;
        }
        if (progress) {
          progress.hidden = false;
          progress.setAttribute('aria-valuenow', String(day));
        }
        if (fill) fill.style.width = `${Math.round((day / CHALLENGE_DAYS) * 100)}%`;
        if (cta) {
          cta.textContent = 'Lanjutkan Challenge';
          cta.hidden = false;
        }
      }
    }
  </script>
</Layout>
